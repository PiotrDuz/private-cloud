#!/usr/bin/env bash
set -u

readonly SMARTCTL_PATH="/usr/sbin/smartctl"

"$SMARTCTL_PATH" "$@"
smartctl_status=$?

# smartctl uses bits 3-7 to report device-health findings in addition to
# including those findings in its JSON output. Zabbix Agent 2 7.0.9+ treats
# every non-zero status as an execution failure (ZBX-27105), which prevents
# discovery precisely when a disk is unhealthy. Preserve invocation, device,
# SMART-command, and signal failures, but let the plugin parse health findings.
if ((smartctl_status >= 128 || (smartctl_status & 7) != 0)); then
    exit "$smartctl_status"
fi

exit 0
