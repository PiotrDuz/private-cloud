apiVersion: v1
kind: ConfigMap
metadata: {name: grafana-config, namespace: observability}
data:
  plugins.yaml: |
    apiVersion: 1
    apps: []
  datasources.yaml: |
    apiVersion: 1
    datasources:
      - name: Loki
        uid: loki
        type: loki
        access: proxy
        url: http://loki:3100
        isDefault: true
        editable: false
        jsonData: {maxLines: 1000, timeout: 60}
  dashboards.yaml: |
    apiVersion: 1
    providers:
      - name: private-cloud
        type: file
        disableDeletion: false
        allowUiUpdates: false
        options: {path: /etc/grafana/provisioning/dashboards}
  logs.json: |
{{ lookup('file', playbook_dir ~ '/../k0s-services/grafana/files/logs.json') | indent(4, true) }}
  contact-points.yaml: |
    apiVersion: 1
    contactPoints:
      - orgId: 1
        name: Stalwart inbox
        receivers:
          - uid: stalwart-inbox
            type: email
            disableResolveMessage: false
            settings:
              addresses: {{ (private_cloud.stalwart.mailbox_username ~ '@' ~ private_cloud.stalwart.forwarding_domain) | to_json }}
              singleEmail: true
    policies:
      - orgId: 1
        receiver: Stalwart inbox
        group_by: ['...']
        group_wait: 0s
        group_interval: 1m
        repeat_interval: 5m
  alerts.yaml: |
    apiVersion: 1
    groups:
      - orgId: 1
        name: private-cloud-logs
        folder: Private cloud
        interval: 1m
        rules:
{% for level in ['warn', 'error', 'critical'] %}
          - uid: private-cloud-logs-{{ level }}
            title: Logs {{ level }}
            condition: C
            for: 0s
            noDataState: OK
            execErrState: Error
            isPaused: {{ (not private_cloud.stages.notifications) | to_json }}
            labels: {severity: {{ level }}, source: loki}
            annotations:
              summary: {{ ('At least one ' ~ level ~ ' log was collected in the last five minutes.') | to_json }}
              runbook_url: {{ ('https://' ~ private_cloud.logging.hostname ~ '/d/private-cloud-logs') | to_json }}
            data:
              - refId: A
                queryType: instant
                relativeTimeRange: {from: 300, to: 0}
                datasourceUid: loki
                model:
                  refId: A
                  expr: 'sum by (namespace, service, container, node, level) (count_over_time({level="{{ level }}"}[5m]))'
                  queryType: instant
                  instant: true
                  intervalMs: 1000
                  maxDataPoints: 43200
              - refId: B
                datasourceUid: __expr__
                relativeTimeRange: {from: 300, to: 0}
                model: {refId: B, type: reduce, expression: A, reducer: last}
              - refId: C
                datasourceUid: __expr__
                relativeTimeRange: {from: 300, to: 0}
                model:
                  refId: C
                  type: threshold
                  expression: B
                  conditions:
                    - evaluator: {params: [0], type: gt}
                      operator: {type: and}
                      query: {params: [C]}
                      reducer: {type: last}
                      type: query
{% endfor %}
          - uid: private-cloud-log-heartbeat
            title: Log collection heartbeat missing
            condition: C
            for: 0s
            noDataState: Alerting
            execErrState: Error
            isPaused: {{ (not private_cloud.stages.notifications) | to_json }}
            labels: {severity: error, source: loki}
            annotations: {summary: 'No host heartbeat has reached Loki for five minutes.'}
            data:
              - refId: A
                queryType: instant
                relativeTimeRange: {from: 300, to: 0}
                datasourceUid: loki
                model:
                  refId: A
                  expr: 'sum(count_over_time({job="host",service="private-cloud-log-heartbeat.service"}[5m])) or vector(0)'
                  queryType: instant
                  instant: true
              - refId: B
                datasourceUid: __expr__
                relativeTimeRange: {from: 300, to: 0}
                model: {refId: B, type: reduce, expression: A, reducer: last}
              - refId: C
                datasourceUid: __expr__
                relativeTimeRange: {from: 300, to: 0}
                model:
                  refId: C
                  type: threshold
                  expression: B
                  conditions:
                    - evaluator: {params: [1], type: lt}
                      operator: {type: and}
                      query: {params: [C]}
                      reducer: {type: last}
                      type: query
