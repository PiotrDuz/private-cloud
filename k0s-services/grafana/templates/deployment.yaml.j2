apiVersion: apps/v1
kind: Deployment
metadata: {name: grafana, namespace: observability}
spec:
  replicas: 1
  strategy: {type: Recreate}
  selector: {matchLabels: {app.kubernetes.io/name: grafana}}
  template:
    metadata:
      labels: {app.kubernetes.io/name: grafana}
      annotations:
        checksum/config: {{ lookup('template', playbook_dir ~ '/../k0s-services/grafana/templates/configmap.yaml.j2') | hash('sha256') }}
    spec:
      serviceAccountName: grafana
      automountServiceAccountToken: false
      nodeSelector: {kubernetes.io/hostname: {{ ansible_hostname | to_json }}}
      terminationGracePeriodSeconds: 90
      securityContext:
        runAsUser: 472
        runAsGroup: 472
        fsGroup: 472
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: grafana
          image: grafana/grafana:13.2.1@sha256:f772d434e8fab0049deb2b1b30abd43342bcfca1537614aa8d36080232cf4283
          envFrom: [{secretRef: {name: grafana-credentials}}]
          env:
            - {name: GF_SERVER_ROOT_URL, value: {{ ('https://' ~ private_cloud.logging.hostname) | to_json }}}
            - {name: GF_AUTH_ANONYMOUS_ENABLED, value: "false"}
            - {name: GF_USERS_ALLOW_SIGN_UP, value: "false"}
            - {name: GF_SECURITY_COOKIE_SECURE, value: "true"}
            - {name: GF_SECURITY_COOKIE_SAMESITE, value: strict}
            - {name: GF_ANALYTICS_REPORTING_ENABLED, value: "false"}
            - {name: GF_ANALYTICS_CHECK_FOR_UPDATES, value: "false"}
            - {name: GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES, value: "false"}
            - {name: GF_PLUGINS_PREINSTALL_DISABLED, value: "true"}
            - {name: GF_LOG_MODE, value: console}
            - {name: GF_LOG_CONSOLE_FORMAT, value: json}
{% if private_cloud.stages.notifications %}
            - {name: GF_SMTP_ENABLED, value: "true"}
            - {name: GF_SMTP_HOST, value: {{ (private_cloud.stalwart.relay_host ~ ':' ~ private_cloud.stalwart.relay_port) | to_json }}}
            - {name: GF_SMTP_USER, value: {{ private_cloud.stalwart.relay_username | to_json }}}
            - {name: GF_SMTP_FROM_ADDRESS, value: {{ private_cloud.notifications.from_address | to_json }}}
            - {name: GF_SMTP_FROM_NAME, value: Private cloud alerts}
            - {name: GF_SMTP_SKIP_VERIFY, value: "false"}
            - {name: GF_SMTP_STARTTLS_POLICY, value: {{ ('NoStartTLS' if private_cloud.stalwart.relay_implicit_tls else 'MandatoryStartTLS') | to_json }}}
{% endif %}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
          ports: [{name: http, containerPort: 3000}]
          resources:
            requests: {cpu: 100m, memory: 128Mi, ephemeral-storage: 128Mi}
            limits: {cpu: "2", memory: {{ private_cloud.logging.grafana_max_ram | to_json }}, ephemeral-storage: 512Mi}
          startupProbe:
            httpGet: {path: /api/health, port: http}
            periodSeconds: 5
            failureThreshold: 60
          readinessProbe:
            httpGet: {path: /api/health, port: http}
            periodSeconds: 10
          volumeMounts:
            - {name: data, mountPath: /var/lib/grafana}
            - {name: config, mountPath: /etc/grafana/provisioning, readOnly: true}
      volumes:
        - {name: data, persistentVolumeClaim: {claimName: grafana-data}}
        - name: config
          configMap:
            name: grafana-config
            items:
              - {key: plugins.yaml, path: plugins/apps.yaml}
              - {key: datasources.yaml, path: datasources/loki.yaml}
              - {key: dashboards.yaml, path: dashboards/provider.yaml}
              - {key: logs.json, path: dashboards/logs.json}
              - {key: contact-points.yaml, path: alerting/contact-points.yaml}
              - {key: alerts.yaml, path: alerting/alerts.yaml}
---
apiVersion: v1
kind: ServiceAccount
metadata: {name: grafana, namespace: observability}
---
apiVersion: v1
kind: Service
metadata: {name: grafana, namespace: observability}
spec:
  selector: {app.kubernetes.io/name: grafana}
  ports: [{name: http, port: 3000, targetPort: http}]
