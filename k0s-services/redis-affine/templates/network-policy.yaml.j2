apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: redis-affine-ingress
  namespace: private-cloud
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: redis-affine
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: affine
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: affine-database-preparation
      ports:
        - {protocol: TCP, port: 6379}
