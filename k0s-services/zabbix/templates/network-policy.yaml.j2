apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: zabbix-server-ingress
  namespace: private-cloud
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: zabbix
      app.kubernetes.io/component: server
  policyTypes: [Ingress]
  ingress:
    - ports:
        - {protocol: TCP, port: 10051}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: zabbix-web-ingress
  namespace: private-cloud
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: zabbix
      app.kubernetes.io/component: web
  policyTypes: [Ingress]
  ingress:
    - ports:
        - {protocol: TCP, port: 8080}
