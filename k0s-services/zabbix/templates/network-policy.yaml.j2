apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: zabbix-server-ingress
  namespace: private-cloud
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: zabbix
      app.kubernetes.io/component: server
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: zabbix
              app.kubernetes.io/component: web
{% for cidr in private_cloud.networking.local_network_cidrs %}
        - ipBlock: {cidr: {{ cidr }}}
{% endfor %}
      ports:
        - {protocol: TCP, port: 10051}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: zabbix-web-ingress
  namespace: private-cloud
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: zabbix
      app.kubernetes.io/component: web
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels: {kubernetes.io/metadata.name: edge}
          podSelector:
            matchLabels: {app.kubernetes.io/name: traefik}
      ports:
        - {protocol: TCP, port: 8080}
