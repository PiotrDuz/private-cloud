apiVersion: v1
kind: ConfigMap
metadata:
  name: traefik-route-grist
  namespace: edge
  labels: {private-cloud.example/traefik-route: "true"}
data:
  grist.yaml: |
    http:
      routers:
        grist:
          entryPoints: [websecure]
          rule: Host(`{{ private_cloud.grist.hostname }}`)
          middlewares: [strip-identity-headers, forward-auth]
          service: grist
          tls:
            certResolver: cloudflare
        grist-oauth2:
          entryPoints: [websecure]
          rule: Host(`{{ private_cloud.grist.hostname }}`) && PathPrefix(`/oauth2/`)
          priority: 10000
          middlewares: [strip-identity-headers]
          service: grist-oauth2
          tls:
            certResolver: cloudflare
      services:
        grist:
          loadBalancer:
            servers:
              - url: http://grist.private-cloud.svc.cluster.local:8484
        grist-oauth2:
          loadBalancer:
            servers:
              - url: http://forward-auth.edge.svc.cluster.local:4180
