apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: grist
  namespace: private-cloud
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls.certresolver: cloudflare
    traefik.ingress.kubernetes.io/router.middlewares: strip-identity-headers@file,forward-auth@file
spec:
  ingressClassName: traefik
  tls:
    - hosts: [{{ private_cloud.grist.hostname }}]
  rules:
    - host: {{ private_cloud.grist.hostname }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: grist
                port: {number: 8484}
