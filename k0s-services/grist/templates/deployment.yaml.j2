apiVersion: apps/v1
kind: Deployment
metadata:
  name: grist
  namespace: private-cloud
  labels:
    app.kubernetes.io/name: grist
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: grist
  template:
    metadata:
      labels:
        app.kubernetes.io/name: grist
    spec:
      serviceAccountName: grist
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile: {type: RuntimeDefault}
      terminationGracePeriodSeconds: 60
      containers:
        - name: grist
          image: gristlabs/grist:1.7.16
          imagePullPolicy: IfNotPresent
          securityContext:
            runAsNonRoot: true
            privileged: false
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
          env:
            - {name: HOME, value: /home/grist}
            - {name: APP_HOME_URL, value: {{ ("https://" ~ private_cloud.grist.hostname) | to_json }}}
            - {name: APP_DOC_URL, value: {{ ("https://" ~ private_cloud.grist.hostname) | to_json }}}
            - {name: GRIST_DEFAULT_EMAIL, value: {{ private_cloud.grist.default_email | to_json }}}
            - {name: GRIST_FORWARD_AUTH_HEADER, value: X-Forwarded-User}
            - {name: GRIST_FORWARD_AUTH_LOGOUT_PATH, value: /_oauth/logout}
            - {name: GRIST_SINGLE_ORG, value: grist}
            - {name: GRIST_SANDBOX_FLAVOR, value: pyodide}
            - {name: GRIST_SINGLE_PORT, value: "true"}
            - {name: TYPEORM_TYPE, value: postgres}
            - {name: TYPEORM_HOST, value: {{ grist_postgres_service | to_json }}}
            - {name: TYPEORM_PORT, value: "5432"}
            - {name: TYPEORM_DATABASE, value: {{ grist_database_name | to_json }}}
            - {name: TYPEORM_USERNAME, value: {{ grist_database_username | to_json }}}
            - name: TYPEORM_PASSWORD
              valueFrom: {secretKeyRef: {name: grist-credentials, key: GRIST_DB_PASSWORD}}
            - name: GRIST_SESSION_SECRET
              valueFrom: {secretKeyRef: {name: grist-credentials, key: GRIST_SESSION_SECRET}}
            - name: GRIST_BOOT_KEY
              valueFrom: {secretKeyRef: {name: grist-credentials, key: GRIST_BOOT_KEY}}
          ports:
            - {name: http, containerPort: 8484, protocol: TCP}
          resources:
            requests: {cpu: 250m, memory: {{ private_cloud.grist.max_ram | to_json }}, ephemeral-storage: 256Mi}
            limits: {memory: {{ private_cloud.grist.max_ram | to_json }}, ephemeral-storage: 2Gi}
          startupProbe:
            httpGet: {path: /, port: http}
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 30
          readinessProbe:
            httpGet: {path: /, port: http}
            initialDelaySeconds: 20
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 30
          livenessProbe:
            httpGet: {path: /, port: http}
            initialDelaySeconds: 60
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 5
          volumeMounts:
            - {name: data, mountPath: /persist}
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: grist-data
