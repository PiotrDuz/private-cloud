apiVersion: apps/v1
kind: Deployment
metadata:
  name: opencloud
  namespace: private-cloud
  labels:
    app.kubernetes.io/name: opencloud
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: opencloud
  template:
    metadata:
      labels:
        app.kubernetes.io/name: opencloud
      annotations:
        private-cloud.example/apps-config-checksum: "{{ lookup('template', manifest_template_dir ~ '/apps-configmap.yaml.j2') | hash('sha256') }}"
        private-cloud.example/app-registry-config-checksum: "{{ lookup('template', manifest_template_dir ~ '/app-registry-configmap.yaml.j2') | hash('sha256') }}"
        private-cloud.example/csp-config-checksum: "{{ lookup('template', manifest_template_dir ~ '/csp-configmap.yaml.j2') | hash('sha256') }}"
        private-cloud.example/wopi-secret-checksum: "{{ opencloud_wopi_secret_checksum }}"
    spec:
      serviceAccountName: opencloud
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile: {type: RuntimeDefault}
      initContainers:
        - name: install-drawio
          image: alpine:3.22.1
          imagePullPolicy: IfNotPresent
          command: [/bin/sh, -c]
          args:
            - |
              set -eu
              app_dir=/opencloud/data/web/assets/apps/draw-io
              if ! grep -q '"version": "2.2.0"' "$app_dir/manifest.json" 2>/dev/null; then
                archive=/tmp/draw-io.zip
                wget -q -O "$archive" https://github.com/opencloud-eu/web-extensions/releases/download/draw-io-v2.2.0/draw-io-2.2.0.zip
                echo "49c3aa32aa517f2a90f249b5470b38dc18b7d006841c442f64335d660b551d0c  $archive" | sha256sum -c -
                mkdir -p /opencloud/config /opencloud/data/web/assets/apps
                unzip -oq "$archive" -d /opencloud/data/web/assets/apps
              fi
          securityContext:
            runAsNonRoot: true
            privileged: false
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
            seccompProfile: {type: RuntimeDefault}
          resources:
            requests: {cpu: 100m, memory: 128Mi, ephemeral-storage: 256Mi}
            limits: {memory: 512Mi, ephemeral-storage: 1Gi}
          volumeMounts:
            - {name: data, mountPath: /opencloud}
      containers:
        - name: opencloud
          image: opencloudeu/opencloud-rolling:7.5.0
          imagePullPolicy: IfNotPresent
          command: [/bin/sh, -c]
          args:
            - opencloud init || true; opencloud server
          securityContext:
            runAsNonRoot: true
            privileged: false
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
            seccompProfile: {type: RuntimeDefault}
          env:
            - {name: OC_URL, value: {{ ("https://" ~ private_cloud.opencloud.hostname) | to_json }}}
            - {name: PROXY_HTTP_ADDR, value: "0.0.0.0:9200"}
            - {name: PROXY_TLS, value: "false"}
            - {name: OC_INSECURE, value: "false"}
            - {name: IDM_CREATE_DEMO_USERS, value: "false"}
            - name: IDM_ADMIN_PASSWORD
              valueFrom: {secretKeyRef: {name: opencloud-credentials, key: IDM_ADMIN_PASSWORD}}
            - {name: OC_EXCLUDE_RUN_SERVICES, value: idp}
            - {name: OC_OIDC_ISSUER, value: {{ ("https://" ~ private_cloud.keycloak.hostname ~ "/realms/private-cloud") | to_json }}}
            - {name: IDP_DOMAIN, value: {{ private_cloud.keycloak.hostname | to_json }}}
            - {name: OC_OIDC_CLIENT_ID, value: opencloud}
            - {name: WEBFINGER_WEB_OIDC_CLIENT_ID, value: opencloud}
            - {name: WEBFINGER_DESKTOP_OIDC_CLIENT_ID, value: opencloud}
            - {name: WEBFINGER_ANDROID_OIDC_CLIENT_ID, value: opencloud}
            - {name: WEBFINGER_IOS_OIDC_CLIENT_ID, value: opencloud}
            - {name: PROXY_OIDC_REWRITE_WELLKNOWN, value: "true"}
            - {name: PROXY_OIDC_ACCESS_TOKEN_VERIFY_METHOD, value: jwt}
            - {name: PROXY_USER_OIDC_CLAIM, value: sub}
            - {name: PROXY_USER_CS3_CLAIM, value: username}
            - {name: PROXY_AUTOPROVISION_ACCOUNTS, value: "true"}
            - {name: PROXY_AUTOPROVISION_CLAIM_USERNAME, value: sub}
            - {name: PROXY_ROLE_ASSIGNMENT_DRIVER, value: oidc}
            - {name: PROXY_ROLE_ASSIGNMENT_OIDC_CLAIM, value: roles}
            - {name: GRAPH_ASSIGN_DEFAULT_USER_ROLE, value: "false"}
            - {name: GRAPH_USERNAME_MATCH, value: none}
            - {name: SETTINGS_SETUP_DEFAULT_ASSIGNMENTS, value: "false"}
            - {name: OC_ADMIN_USER_ID, value: ""}
            - {name: WEB_OPTION_ACCOUNT_EDIT_LINK_HREF, value: {{ ("https://" ~ private_cloud.keycloak.hostname ~ "/realms/private-cloud/account") | to_json }}}
            - {name: SEARCH_ENGINE_TYPE, value: bleve}
            - {name: SEARCH_ENGINE_BLEVE_DATA_PATH, value: /var/lib/opencloud/search}
            - {name: SEARCH_EXTRACTOR_TYPE, value: tika}
            - {name: SEARCH_EXTRACTOR_TIKA_TIKA_URL, value: "http://tika:9998"}
            - {name: FRONTEND_FULL_TEXT_SEARCH_ENABLED, value: "true"}
            - {name: OC_CACHE_STORE, value: memory}
            - {name: STORAGE_USERS_DRIVER, value: posix}
            - {name: STORAGE_USERS_POSIX_ROOT, value: /var/lib/opencloud/storage/users}
            - {name: STORAGE_USERS_ID_CACHE_STORE, value: memory}
            - {name: STORAGE_SYSTEM_DRIVER, value: decomposed}
            - {name: WEB_ASSET_APPS_PATH, value: /var/lib/opencloud/web/assets/apps}
            - {name: PROXY_CSP_CONFIG_FILE_LOCATION, value: /etc/opencloud/csp.yaml}
            - {name: OC_ADD_RUN_SERVICES, value: collaboration}
            - {name: COLLABORATION_APP_NAME, value: OnlyOffice}
            - {name: COLLABORATION_APP_PRODUCT, value: OnlyOffice}
            - {name: COLLABORATION_APP_ADDR, value: {{ ("https://" ~ private_cloud.onlyoffice.hostname) | to_json }}}
            - {name: COLLABORATION_APP_ICON, value: {{ ("https://" ~ private_cloud.onlyoffice.hostname ~ "/web-apps/apps/documenteditor/main/resources/img/favicon.ico") | to_json }}}
            - {name: COLLABORATION_APP_INSECURE, value: "false"}
            - {name: COLLABORATION_APP_PROOF_DISABLE, value: "true"}
            - {name: COLLABORATION_WOPI_SRC, value: {{ ("https://" ~ private_cloud.opencloud.hostname) | to_json }}}
            - name: COLLABORATION_WOPI_SECRET
              valueFrom: {secretKeyRef: {name: onlyoffice-credentials, key: JWT_SECRET}}
            - {name: COLLABORATION_CS3API_DATAGATEWAY_INSECURE, value: "false"}
          ports:
            - {name: http, containerPort: 9200, protocol: TCP}
          resources:
            requests: {cpu: 500m, memory: {{ private_cloud.opencloud.max_ram | to_json }}, ephemeral-storage: 512Mi}
            limits: {memory: {{ private_cloud.opencloud.max_ram | to_json }}, ephemeral-storage: 4Gi}
          startupProbe:
            httpGet: {path: /health, port: http}
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 30
          readinessProbe:
            httpGet: {path: /health, port: http}
            initialDelaySeconds: 10
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 24
          livenessProbe:
            httpGet: {path: /health, port: http}
            initialDelaySeconds: 60
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 6
          volumeMounts:
            - {name: data, mountPath: /etc/opencloud, subPath: config}
            - {name: data, mountPath: /var/lib/opencloud, subPath: data}
            - {name: bleve-data, mountPath: /var/lib/opencloud/search}
            - {name: apps-config, mountPath: /etc/opencloud/apps.yaml, subPath: apps.yaml, readOnly: true}
            - {name: app-registry-config, mountPath: /etc/opencloud/app-registry.yaml, subPath: app-registry.yaml, readOnly: true}
            - {name: csp-config, mountPath: /etc/opencloud/csp.yaml, subPath: csp.yaml, readOnly: true}
      volumes:
        - name: data
          persistentVolumeClaim: {claimName: opencloud-data}
        - name: bleve-data
          persistentVolumeClaim: {claimName: bleve-data}
        - name: apps-config
          configMap: {name: opencloud-apps}
        - name: app-registry-config
          configMap: {name: opencloud-app-registry}
        - name: csp-config
          configMap: {name: opencloud-csp}
