apiVersion: v1
kind: ConfigMap
metadata:
  name: traefik-route-stalwart
  namespace: edge
  labels: {private-cloud.example/traefik-route: "true"}
data:
  stalwart.yaml: |
    http:
      routers:
        stalwart:
          entryPoints: [websecure]
          rule: Host(`{{ private_cloud.stalwart.hostname }}`)
          middlewares: [strip-forwarded]
          service: stalwart
          tls:
            certResolver: cloudflare
{% if private_cloud.stages.opencloud | bool %}
        # OpenCloud Web exchanges and refreshes tokens from the browser, which needs CORS on the OAuth endpoints.
        stalwart-oauth:
          entryPoints: [websecure]
          rule: Host(`{{ private_cloud.stalwart.hostname }}`) && PathPrefix(`/auth/`)
          middlewares: [strip-forwarded, stalwart-oauth-cors]
          service: stalwart
          tls:
            certResolver: cloudflare
      middlewares:
        stalwart-oauth-cors:
          headers:
            accessControlAllowOriginList: [{{ ("https://" ~ private_cloud.opencloud.hostname) | to_json }}]
            accessControlAllowMethods: [GET, POST, OPTIONS]
            accessControlAllowHeaders: [Authorization, Content-Type]
            accessControlMaxAge: 600
{% endif %}
      services:
        stalwart:
          loadBalancer:
            servers:
              - url: http://stalwart.private-cloud.svc.cluster.local:8080
