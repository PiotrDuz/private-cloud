apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: stalwart
  namespace: private-cloud
  labels:
    app.kubernetes.io/name: stalwart
spec:
  serviceName: stalwart-headless
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: stalwart
  template:
    metadata:
      labels:
        app.kubernetes.io/name: stalwart
        app.kubernetes.io/component: server
    spec:
      serviceAccountName: stalwart
      automountServiceAccountToken: false
      enableServiceLinks: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 2000
        runAsGroup: 2000
        fsGroup: 2000
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile: {type: RuntimeDefault}
      initContainers:
        - name: wait-for-postgres
          image: {{ stalwart_wait_image }}
          imagePullPolicy: IfNotPresent
          command:
            - python3
            - /api-check/wait_for_api.py
            - {{ stalwart_postgres_service | to_json }}
            - {{ stalwart_postgres_port | string | to_json }}
            - '0'
          securityContext:
            runAsNonRoot: true
            runAsUser: 65532
            runAsGroup: 65532
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
            seccompProfile: {type: RuntimeDefault}
          resources:
            requests: {cpu: 10m, memory: 32Mi}
            limits: {memory: 64Mi}
          volumeMounts:
            - {name: api-check, mountPath: /api-check, readOnly: true}
      containers:
        - name: stalwart
          image: {{ stalwart_image }}
          imagePullPolicy: IfNotPresent
          args: [--config, /etc/stalwart/config.json]
          securityContext:
            runAsNonRoot: true
            privileged: false
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL], add: [NET_BIND_SERVICE]}
            seccompProfile: {type: RuntimeDefault}
          env:
            - {name: STALWART_PUBLIC_URL, value: {{ ("https://" ~ private_cloud.stalwart.hostname) | to_json }}}
            - name: STALWART_DB_PASSWORD
              valueFrom: {secretKeyRef: {name: stalwart-runtime-credentials, key: STALWART_DB_PASSWORD}}
            - name: INBOX_EU_SMTP_PASSWORD
              valueFrom: {secretKeyRef: {name: stalwart-runtime-credentials, key: INBOX_EU_SMTP_PASSWORD}}
            - name: STALWART_CLOUDFLARE_API_TOKEN
              valueFrom: {secretKeyRef: {name: stalwart-runtime-credentials, key: STALWART_CLOUDFLARE_API_TOKEN}}
            - name: STALWART_MEILISEARCH_API_KEY
              valueFrom: {secretKeyRef: {name: stalwart-runtime-credentials, key: STALWART_MEILISEARCH_API_KEY}}
            - name: STALWART_RECOVERY_ADMIN
              valueFrom:
                secretKeyRef:
                  name: stalwart-recovery-credentials
                  key: STALWART_RECOVERY_ADMIN
                  optional: true
          ports:
            - {name: management, containerPort: 8080, protocol: TCP}
{% if private_cloud.stages.notifications %}
            - {name: alert-smtp, containerPort: {{ private_cloud_alert_smtp_port }}, protocol: TCP}
{% endif %}
          resources:
            requests: {cpu: 250m, memory: {{ private_cloud_memory_requests.stalwart | private_cloud_memory_request(private_cloud.stalwart.max_ram) }}, ephemeral-storage: 256Mi}
            limits: {memory: {{ private_cloud.stalwart.max_ram | to_json }}, ephemeral-storage: 2Gi}
          startupProbe:
            httpGet: {path: /healthz/ready, port: management}
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 30
          readinessProbe:
            httpGet: {path: /healthz/ready, port: management}
            initialDelaySeconds: 10
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 24
          livenessProbe:
            httpGet: {path: /healthz/live, port: management}
            initialDelaySeconds: 30
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 6
          volumeMounts:
            - {name: config, mountPath: /etc/stalwart/config.json, subPath: config.json, readOnly: true}
            - {name: data, mountPath: /var/lib/stalwart}
            - {name: temporary, mountPath: /tmp}
        # Follows the external inbox and hands new mail to the SMTP listener with the original client in Proxy Protocol.
        - name: imap-fetch
          image: {{ stalwart_wait_image }}
          imagePullPolicy: IfNotPresent
          command: [python3, -u, /imap-fetch/imap_fetch.py]
          securityContext:
            runAsNonRoot: true
            privileged: false
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
            seccompProfile: {type: RuntimeDefault}
          env:
            - {name: PYTHONDONTWRITEBYTECODE, value: '1'}
            - {name: IMAP_HOST, value: {{ private_cloud.stalwart.relay_host | to_json }}}
            - {name: IMAP_USERNAME, value: {{ private_cloud.stalwart.relay_username | to_json }}}
            - name: IMAP_PASSWORD
              valueFrom: {secretKeyRef: {name: stalwart-runtime-credentials, key: INBOX_EU_SMTP_PASSWORD}}
            - {name: RECIPIENT, value: {{ (private_cloud.stalwart.mailbox_username ~ '@' ~ private_cloud.stalwart.domain) | to_json }}}
            - {name: RECEIVER_DOMAIN, value: {{ stalwart_imap_fetch_receiver_domain | to_json }}}
            - {name: STATE_PATH, value: {{ stalwart_imap_fetch_state_path | to_json }}}
          resources:
            requests: {cpu: 10m, memory: {{ private_cloud_memory_requests.imap_fetch }}}
            limits: {memory: 256Mi}
          volumeMounts:
            - {name: imap-fetch, mountPath: /imap-fetch, readOnly: true}
            - {name: data, mountPath: /var/lib/stalwart}
      volumes:
        - name: imap-fetch
          configMap:
            name: stalwart-config
            items: [{key: imap_fetch.py, path: imap_fetch.py}, {key: imap_fetch_helpers.py, path: imap_fetch_helpers.py}]
        - name: api-check
          configMap:
            name: stalwart-config
            items: [{key: wait_for_api.py, path: wait_for_api.py}]
        - name: config
          configMap: {name: stalwart-config}
        - name: data
          persistentVolumeClaim: {claimName: stalwart-data}
        - name: temporary
          emptyDir: {}
