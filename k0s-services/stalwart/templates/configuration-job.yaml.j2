apiVersion: batch/v1
kind: Job
metadata:
  name: stalwart-configure
  namespace: private-cloud
  labels:
    app.kubernetes.io/name: stalwart
    app.kubernetes.io/component: configuration
spec:
  backoffLimit: 2
  ttlSecondsAfterFinished: 300
  template:
    metadata:
      labels:
        app.kubernetes.io/name: stalwart
        app.kubernetes.io/component: configuration
    spec:
      serviceAccountName: stalwart-configuration
      automountServiceAccountToken: false
      restartPolicy: Never
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: configure
          image: ghcr.io/stalwartlabs/cli:latest@sha256:fe199affac1d120a8c200ef39ae629765a2976270e0453575c1caf906ee15b52
          imagePullPolicy: IfNotPresent
          securityContext:
            runAsNonRoot: true
            privileged: false
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
          args: [apply, --file, /configuration/plan.ndjson, --json]
          env:
            - {name: STALWART_URL, value: "http://stalwart:8080"}
            - name: STALWART_USER
              valueFrom: {secretKeyRef: {name: stalwart-recovery-credentials, key: STALWART_USER}}
            - name: STALWART_PASSWORD
              valueFrom: {secretKeyRef: {name: stalwart-recovery-credentials, key: STALWART_PASSWORD}}
          resources:
            requests: {cpu: 100m, memory: 128Mi, ephemeral-storage: 128Mi}
            limits: {memory: 512Mi, ephemeral-storage: 512Mi}
          volumeMounts:
            - {name: configuration, mountPath: /configuration, readOnly: true}
      volumes:
        - name: configuration
          secret: {secretName: stalwart-configuration-plan}
