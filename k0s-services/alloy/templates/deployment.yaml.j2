apiVersion: apps/v1
kind: Deployment
metadata: {name: alloy, namespace: observability}
spec:
  replicas: 1
  strategy: {type: Recreate}
  selector: {matchLabels: {app.kubernetes.io/name: alloy}}
  template:
    metadata:
      labels: {app.kubernetes.io/name: alloy}
      annotations:
        checksum/config: {{ lookup('template', playbook_dir ~ '/../k0s-services/alloy/templates/configmap.yaml.j2') | hash('sha256') }}
    spec:
      serviceAccountName: alloy
      automountServiceAccountToken: true
      nodeSelector: {kubernetes.io/hostname: {{ ansible_hostname | to_json }}}
      terminationGracePeriodSeconds: 90
      securityContext:
        runAsUser: 0
        runAsGroup: 0
        fsGroup: 0
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: alloy
          image: grafana/alloy:v1.19.2@sha256:b8ec653c44235fbe910879145dac3597d66b0aaecf60bcbbe82580767771a839
          args: [run, /etc/alloy/config.alloy, --storage.path=/data, --server.http.listen-addr=0.0.0.0:12345, --stability.level=experimental, --disable-reporting]
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
          env:
            - name: NODE_NAME
              valueFrom: {fieldRef: {fieldPath: spec.nodeName}}
          ports: [{name: http, containerPort: 12345}]
          resources:
            requests: {cpu: 100m, memory: 128Mi, ephemeral-storage: 128Mi}
            limits: {memory: {{ private_cloud.logging.alloy_max_ram | to_json }}, ephemeral-storage: 512Mi}
          startupProbe:
            httpGet: {path: /-/ready, port: http}
            periodSeconds: 5
            failureThreshold: 60
          readinessProbe:
            httpGet: {path: /-/ready, port: http}
            periodSeconds: 10
          livenessProbe:
            httpGet: {path: /-/healthy, port: http}
            periodSeconds: 30
            timeoutSeconds: 3
            failureThreshold: 6
          volumeMounts:
            - {name: pod-logs, mountPath: /var/log/pods, readOnly: true}
            - {name: journal, mountPath: /var/log/journal, readOnly: true}
            - {name: machine-id, mountPath: /etc/machine-id, readOnly: true}
            - {name: data, mountPath: /data}
            - {name: config, mountPath: /etc/alloy, readOnly: true}
            - {name: credentials, mountPath: /etc/alloy/credentials, readOnly: true}
      volumes:
        - {name: pod-logs, hostPath: {path: /tank/secure/k0s/kubelet/logs, type: Directory}}
        - {name: journal, hostPath: {path: /var/log/journal, type: Directory}}
        - {name: machine-id, hostPath: {path: /etc/machine-id, type: File}}
        - {name: data, persistentVolumeClaim: {claimName: alloy-data}}
        - {name: config, configMap: {name: alloy-config}}
        - name: credentials
          secret:
            secretName: openobserve-ingest
            defaultMode: 256
            items:
              - {key: username, path: username}
              - {key: ingest-password, path: password}
---
apiVersion: v1
kind: ServiceAccount
metadata: {name: alloy, namespace: observability}
---
apiVersion: v1
kind: Service
metadata: {name: alloy, namespace: observability}
spec:
  selector: {app.kubernetes.io/name: alloy}
  ports: [{name: http, port: 12345, targetPort: http}]
