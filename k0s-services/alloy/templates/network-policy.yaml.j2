apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: alloy-discovery, namespace: observability}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/name: alloy}}
  policyTypes: [Egress]
  egress:
    - to:
        - ipBlock: {cidr: {{ private_cloud.networking.traefik_internal_ip }}/32}
      ports: [{protocol: TCP, port: 6443}]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: alloy-monitoring, namespace: observability}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/name: alloy}}
  policyTypes: [Ingress]
  ingress:
    - from:
        - ipBlock: {cidr: {{ private_cloud.networking.traefik_internal_ip }}/32}
      ports: [{protocol: TCP, port: 12345}]
