apiVersion: apps/v1
kind: Deployment
metadata:
  name: tika
  namespace: private-cloud
  labels:
    app.kubernetes.io/name: tika
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: tika
  template:
    metadata:
      labels:
        app.kubernetes.io/name: tika
    spec:
      serviceAccountName: tika
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 35002
        runAsGroup: 35002
        fsGroup: 35002
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: tika
          image: apache/tika:3.3.1.0
          imagePullPolicy: IfNotPresent
          securityContext:
            runAsNonRoot: true
            privileged: false
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
          ports:
            - {name: http, containerPort: 9998, protocol: TCP}
          resources:
            requests: {cpu: 250m, memory: {{ private_cloud.tika.max_ram | to_json }}, ephemeral-storage: 512Mi}
            limits: {memory: {{ private_cloud.tika.max_ram | to_json }}, ephemeral-storage: 4Gi}
          startupProbe:
            httpGet: {path: /tika, port: http}
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 30
          readinessProbe:
            httpGet: {path: /tika, port: http}
            initialDelaySeconds: 5
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 24
          livenessProbe:
            httpGet: {path: /tika, port: http}
            initialDelaySeconds: 30
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 6
          volumeMounts:
            - {name: data, mountPath: /var/lib/tika}
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: tika-data
