apiVersion: v1
kind: ConfigMap
metadata:
  name: onlyoffice-config
  namespace: private-cloud
  labels:
    app.kubernetes.io/name: onlyoffice
data:
  local-production-linux.json: |
    {{ {
      'services': {'CoAuthoring': {'ipfilter': {'rules': [
        {'address': private_cloud.opencloud.hostname, 'allowed': true},
        {'address': '*', 'allowed': false}
      ]}}}
    } | to_json }}
