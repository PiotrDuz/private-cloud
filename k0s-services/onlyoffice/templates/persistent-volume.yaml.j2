apiVersion: v1
kind: PersistentVolume
metadata:
  name: onlyoffice-data
  labels:
    app.kubernetes.io/name: onlyoffice
spec:
  capacity:
    storage: 10Ti
  volumeMode: Filesystem
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ""
  claimRef:
    namespace: private-cloud
    name: onlyoffice-data
  local:
    path: {{ onlyoffice_dataset_mountpoint | to_json }}
  nodeAffinity:
    required:
      nodeSelectorTerms:
        - matchExpressions:
            - key: kubernetes.io/hostname
              operator: In
              values:
                - {{ onlyoffice_node_name | to_json }}
