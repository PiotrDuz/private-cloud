apiVersion: apps/v1
kind: Deployment
metadata:
  name: onlyoffice
  namespace: private-cloud
  labels:
    app.kubernetes.io/name: onlyoffice
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: onlyoffice
  template:
    metadata:
      labels:
        app.kubernetes.io/name: onlyoffice
      annotations:
        private-cloud.example/config-checksum: "{{ lookup('template', manifest_template_dir ~ '/configmap.yaml.j2') | hash('sha256') }}"
    spec:
      serviceAccountName: onlyoffice
      automountServiceAccountToken: false
      hostUsers: false
      securityContext:
        runAsUser: 0
        runAsGroup: 0
        seccompProfile: {type: RuntimeDefault}
      terminationGracePeriodSeconds: 300
      containers:
        - name: onlyoffice
          image: onlyoffice/documentserver:9.4.0.1@sha256:3ab6ebc7c605e5a32b7ae3ff19daed4925090245acc8100ce2230bd766c88212
          imagePullPolicy: IfNotPresent
          securityContext:
            privileged: false
            allowPrivilegeEscalation: false
            capabilities:
              drop: [ALL]
              add: [CHOWN, DAC_OVERRIDE, FOWNER, KILL, NET_BIND_SERVICE, SETGID, SETUID]
          env:
            - {name: WOPI_ENABLED, value: "true"}
            - {name: USE_UNAUTHORIZED_STORAGE, value: "false"}
            - {name: JWT_ENABLED, value: "true"}
            - {name: JWT_HEADER, value: Authorization}
            - name: JWT_SECRET
              valueFrom:
                secretKeyRef:
                  name: onlyoffice-credentials
                  key: JWT_SECRET
          ports:
            - {name: http, containerPort: 80, protocol: TCP}
          resources:
            requests: {cpu: 500m, memory: {{ private_cloud_memory_requests.onlyoffice | private_cloud_memory_request(private_cloud.onlyoffice.max_ram) }}, ephemeral-storage: 512Mi}
            limits: {memory: {{ private_cloud.onlyoffice.max_ram | to_json }}, ephemeral-storage: 4Gi}
          startupProbe:
            httpGet: {path: /hosting/discovery, port: http}
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 30
          readinessProbe:
            httpGet: {path: /hosting/discovery, port: http}
            initialDelaySeconds: 30
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 30
          livenessProbe:
            httpGet: {path: /hosting/discovery, port: http}
            initialDelaySeconds: 120
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 5
          lifecycle:
            preStop:
              exec:
                command: [/bin/bash, -c, /usr/bin/documentserver-prepare4shutdown.sh]
          volumeMounts:
            - {name: data, mountPath: /var/log/onlyoffice, subPath: logs}
            - {name: data, mountPath: /var/www/onlyoffice/Data, subPath: data}
            - {name: data, mountPath: /var/lib/onlyoffice, subPath: lib}
            - {name: data, mountPath: /var/lib/postgresql, subPath: postgresql}
            - {name: config, mountPath: /etc/onlyoffice/documentserver/local-production-linux.json, subPath: local-production-linux.json, readOnly: true}
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: onlyoffice-data
        - name: config
          configMap: {name: onlyoffice-config}
