apiVersion: v1
kind: ConfigMap
metadata:
  name: media-vpn-dns
  namespace: media
data:
  Corefile: |
    cluster.local:53 {
        errors
        cache 30
        forward . {{ private_cloud.networking.cluster_dns_ip }}
    }
    .:53 {
        errors
        cache 30
        forward . 1.1.1.1 1.0.0.1
    }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: media-vpn
  namespace: media
spec:
  replicas: 1
  selector:
    matchLabels: {app.kubernetes.io/name: media-vpn}
  template:
    metadata:
      labels: {app.kubernetes.io/name: media-vpn}
    spec:
      automountServiceAccountToken: false
      containers:
        - name: openvpn
          image: {{ media_openvpn_image }}
          env:
            - {name: VPN_SERVICE_PROVIDER, value: custom}
            - {name: VPN_TYPE, value: openvpn}
            - {name: OPENVPN_CUSTOM_CONFIG, value: /run/media-vpn/custom.conf}
            - name: OPENVPN_USER
              valueFrom: {secretKeyRef: {name: media-vpn, key: username}}
            - name: OPENVPN_PASSWORD
              valueFrom: {secretKeyRef: {name: media-vpn, key: password}}
            - {name: FIREWALL, value: 'on'}
            - {name: FIREWALL_INPUT_PORTS, value: '53,8388'}
            - {name: FIREWALL_OUTBOUND_SUBNETS, value: {{ private_cloud.networking.service_cidr | to_json }}}
            - {name: SHADOWSOCKS, value: 'on'}
            - {name: SHADOWSOCKS_CIPHER, value: aes-256-gcm}
            - name: SHADOWSOCKS_PASSWORD
              valueFrom: {secretKeyRef: {name: media-vpn, key: proxy-password}}
          ports:
            - {name: proxy-tcp, containerPort: 8388, protocol: TCP}
            - {name: proxy-udp, containerPort: 8388, protocol: UDP}
          readinessProbe: {tcpSocket: {port: proxy-tcp}, periodSeconds: 5}
          livenessProbe: {tcpSocket: {port: proxy-tcp}, initialDelaySeconds: 20, periodSeconds: 10}
          resources:
            requests: {cpu: 100m, memory: 128Mi}
            limits: {memory: 512Mi}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL], add: [NET_ADMIN]}
            seccompProfile: {type: RuntimeDefault}
          volumeMounts:
            - {name: tun, mountPath: /dev/net/tun}
            - {name: config, mountPath: /run/media-vpn, readOnly: true}
        - name: dns
          image: {{ media_coredns_image }}
          args: [-conf, /etc/coredns/Corefile]
          ports:
            - {name: dns-udp, containerPort: 53, protocol: UDP}
            - {name: dns-tcp, containerPort: 53, protocol: TCP}
          readinessProbe: {tcpSocket: {port: dns-tcp}, periodSeconds: 5}
          livenessProbe: {tcpSocket: {port: dns-tcp}, initialDelaySeconds: 10, periodSeconds: 10}
          resources:
            requests: {cpu: 20m, memory: 32Mi}
            limits: {memory: 128Mi}
          securityContext:
            runAsNonRoot: true
            runAsUser: 65532
            runAsGroup: 65532
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL], add: [NET_BIND_SERVICE]}
            seccompProfile: {type: RuntimeDefault}
          volumeMounts:
            - {name: dns-config, mountPath: /etc/coredns, readOnly: true}
      volumes:
        - {name: tun, hostPath: {path: /dev/net/tun, type: CharDevice}}
        - {name: config, secret: {secretName: media-vpn, defaultMode: 0400}}
        - {name: dns-config, configMap: {name: media-vpn-dns, defaultMode: 0444}}
---
apiVersion: v1
kind: Service
metadata:
  name: media-vpn
  namespace: media
spec:
  clusterIP: {{ private_cloud.media.openvpn.gateway_cluster_ip }}
  selector: {app.kubernetes.io/name: media-vpn}
  ports:
    - {name: proxy-tcp, port: 8388, targetPort: proxy-tcp, protocol: TCP}
    - {name: proxy-udp, port: 8388, targetPort: proxy-udp, protocol: UDP}
    - {name: dns-udp, port: 53, targetPort: dns-udp, protocol: UDP}
    - {name: dns-tcp, port: 53, targetPort: dns-tcp, protocol: TCP}
---
{% set guarded = [
  {'name': 'sonarr', 'port': 8989},
  {'name': 'radarr', 'port': 7878},
  {'name': 'prowlarr', 'port': 9696},
  {'name': 'qbittorrent', 'port': 8080}
] %}
{% for app in guarded %}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ app.name }}
  namespace: media
spec:
  replicas: 1
{% if app.name == 'qbittorrent' %}
  strategy: {type: Recreate}
{% endif %}
  selector:
    matchLabels: {app.kubernetes.io/name: {{ app.name }}}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ app.name }}
        private-cloud.example/openvpn-guarded: 'true'
{% if app.name == 'qbittorrent' %}
      annotations:
        checksum/logging-settings: {{ (lookup('file', playbook_dir ~ '/../logging/configure_qbittorrent.py') ~ lookup('file', playbook_dir ~ '/../logging/qbittorrent_helpers.py')) | hash('sha256') }}
        checksum/qbittorrent-credentials: {{ private_cloud_secrets.media.qbittorrent_password | hash('sha256') }}
        checksum/file-logs: {{ lookup('file', playbook_dir ~ '/../k0s-services/arr/files/file-logs.conf') | hash('sha256') }}
{% endif %}
    spec:
      automountServiceAccountToken: false
      initContainers:
        - name: prepare-runtime
          image: {{ media_images[app.name] }}
          command: [/bin/sh, -ceu, 'chown 1000:1000 /run']
          securityContext:
            runAsUser: 0
            runAsGroup: 0
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL], add: [CHOWN]}
            seccompProfile: {type: RuntimeDefault}
          resources:
            requests: {cpu: 10m, memory: 16Mi}
            limits: {memory: 64Mi}
          volumeMounts:
            - {name: runtime, mountPath: /run}
{% if app.name == 'qbittorrent' %}
        - name: configure-logging
          image: python:3.14-alpine@sha256:c6ead215bfd31f1e433d968853b7a769989117115b728874824e6c0a27cb96fc
          command: [python3, /scripts/configure.py]
          env:
            - {name: PYTHONDONTWRITEBYTECODE, value: '1'}
            - name: QBITTORRENT_PASSWORD
              valueFrom: {secretKeyRef: {name: qbittorrent-credentials, key: password}}
          securityContext:
            runAsNonRoot: true
            runAsUser: 1000
            runAsGroup: 1000
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
            seccompProfile: {type: RuntimeDefault}
          resources:
            requests: {cpu: 10m, memory: 32Mi}
            limits: {memory: 64Mi}
          volumeMounts:
            - {name: config, mountPath: /config}
            - {name: logging-settings, mountPath: /scripts, readOnly: true}
        - name: file-logs
          restartPolicy: Always
          image: fluent/fluent-bit:4.2.3@sha256:a5761fa961cb22dd0875883a4d446b1acd99d4935d77358aa9f50ee177e44fe2
          args: [-c, /etc/file-logs/fluent-bit.conf]
          env:
            - {name: LOG_PATH, value: /logs/qbittorrent.log}
          resources:
            requests: {cpu: 10m, memory: 32Mi}
            limits: {memory: 128Mi}
          securityContext:
            runAsNonRoot: true
            runAsUser: 1000
            runAsGroup: 1000
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
            seccompProfile: {type: RuntimeDefault}
          volumeMounts:
            - {name: config, mountPath: /logs, subPath: qBittorrent/logs, readOnly: true}
            - {name: config, mountPath: /state, subPath: .log-forwarder}
            - {name: file-logs-config, mountPath: /etc/file-logs, readOnly: true}
{% endif %}
      dnsPolicy: None
      dnsConfig:
        nameservers: [{{ private_cloud.media.openvpn.gateway_cluster_ip }}]
        searches: [media.svc.cluster.local, svc.cluster.local, cluster.local]
        options:
          - {name: ndots, value: '5'}
      containers:
        - name: {{ app.name }}
          image: {{ media_images[app.name] }}
          env:
            - {name: TZ, value: {{ private_cloud.media.timezone | to_json }}}
{% if app.name == 'qbittorrent' %}
            - {name: WEBUI_PORT, value: '8080'}
            - {name: TORRENTING_PORT, value: '6881'}
{% endif %}
          ports:
            - {name: http, containerPort: {{ app.port }}, protocol: TCP}
          readinessProbe: {tcpSocket: {port: http}, initialDelaySeconds: 10, periodSeconds: 10}
          livenessProbe: {tcpSocket: {port: http}, initialDelaySeconds: 30, periodSeconds: 20}
          resources:
            requests: {cpu: 100m, memory: 256Mi}
            limits: {memory: 2Gi}
          securityContext:
            runAsNonRoot: true
            runAsUser: 1000
            runAsGroup: 1000
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
            seccompProfile: {type: RuntimeDefault}
          volumeMounts:
            - {name: runtime, mountPath: /run}
            - {name: config, mountPath: /config}
{% if app.name in ['sonarr', 'radarr', 'qbittorrent'] %}
            - {name: library, mountPath: /media}
{% endif %}
        - name: vpn-route
          image: {{ media_tun2socks_image }}
          command: [/bin/sh, -ceu]
          args:
            - |
              original_gateway=$(ip route show default | awk '{print $3}')
              ip route add {{ private_cloud.media.openvpn.gateway_cluster_ip }}/32 via "$original_gateway"
              ip route add {{ private_cloud.networking.service_cidr }} via "$original_gateway"
              ip tuntap add mode tun dev tun0
              ip address add 198.18.0.1/15 dev tun0
              ip link set tun0 up
              ip route replace default dev tun0
              exec tun2socks -device tun://tun0 -proxy "ss://aes-256-gcm:${PROXY_PASSWORD}@{{ private_cloud.media.openvpn.gateway_cluster_ip }}:8388"
          env:
            - name: PROXY_PASSWORD
              valueFrom: {secretKeyRef: {name: media-vpn, key: proxy-password}}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL], add: [NET_ADMIN]}
            seccompProfile: {type: RuntimeDefault}
          resources:
            requests: {cpu: 20m, memory: 32Mi}
            limits: {memory: 256Mi}
          readinessProbe:
            exec: {command: [ip, link, show, tun0]}
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            exec: {command: [ip, link, show, tun0]}
            initialDelaySeconds: 20
            periodSeconds: 30
          volumeMounts:
            - {name: tun, mountPath: /dev/net/tun}
      volumes:
        - {name: runtime, emptyDir: {}}
        - {name: config, persistentVolumeClaim: {claimName: {{ app.name }}-data}}
        - {name: tun, hostPath: {path: /dev/net/tun, type: CharDevice}}
{% if app.name == 'qbittorrent' %}
        - {name: file-logs-config, configMap: {name: arr-file-logs}}
        - {name: logging-settings, configMap: {name: qbittorrent-logging}}
{% endif %}
{% if app.name in ['sonarr', 'radarr', 'qbittorrent'] %}
        - {name: library, persistentVolumeClaim: {claimName: media-library-data}}
{% endif %}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ app.name }}
  namespace: media
spec:
  selector: {app.kubernetes.io/name: {{ app.name }}}
  ports: [{name: http, port: {{ app.port }}, targetPort: http, protocol: TCP}]
---
{% endfor %}
