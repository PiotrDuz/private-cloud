apiVersion: v1
kind: ConfigMap
metadata:
  name: traefik-route-radarr
  namespace: edge
  labels: {private-cloud.example/traefik-route: "true"}
data:
  radarr.yaml: |
    http:
      routers:
        radarr:
          entryPoints: [websecure]
          rule: Host(`{{ private_cloud.media.radarr_hostname }}`)
          service: radarr
          middlewares: [radarr-local-only]
          tls:
            certResolver: cloudflare
      # LAN clients keep their source address; VPN peers arrive masqueraded from the AmneziaWG pod.
      middlewares:
        radarr-local-only:
          ipAllowList:
            sourceRange:
{% for network in private_cloud.networking.local_network_cidrs %}
              - {{ network }}
{% endfor %}
              - {{ private_cloud.networking.pod_cidr }}
      services:
        radarr:
          loadBalancer:
            servers:
              - url: http://radarr.media.svc.cluster.local:7878
