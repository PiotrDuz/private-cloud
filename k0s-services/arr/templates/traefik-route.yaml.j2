{% for app in [{'name': 'sonarr', 'port': 8989}, {'name': 'radarr', 'port': 7878}, {'name': 'prowlarr', 'port': 9696}, {'name': 'bazarr', 'port': 6767}] %}
apiVersion: v1
kind: ConfigMap
metadata:
  name: traefik-route-{{ app.name }}
  namespace: edge
  labels: {private-cloud.example/traefik-route: "true"}
data:
  {{ app.name }}.yaml: |
    http:
      routers:
        {{ app.name }}:
          entryPoints: [vpn]
          rule: Host(`{{ private_cloud.media[app.name ~ '_hostname'] }}`)
          service: {{ app.name }}
          tls:
            certResolver: cloudflare
        {{ app.name }}-lan:
          entryPoints: [websecure]
          rule: Host(`{{ private_cloud.media[app.name ~ '_hostname'] }}`)
          service: {{ app.name }}
          middlewares: [local-only]
          tls:
            certResolver: cloudflare
      services:
        {{ app.name }}:
          loadBalancer:
            servers:
              - url: http://{{ app.name }}.media.svc.cluster.local:{{ app.port }}
---
{% endfor %}
