{% for app in [{'name': 'radarr', 'port': 7878}, {'name': 'prowlarr', 'port': 9696}] %}
apiVersion: v1
kind: ConfigMap
metadata:
  name: traefik-route-{{ app.name }}
  namespace: edge
  labels: {private-cloud.example/traefik-route: "true"}
data:
  {{ app.name }}.yaml: |
    http:
      routers:
        {{ app.name }}:
          entryPoints: [websecure]
          rule: Host(`{{ private_cloud.media[app.name ~ '_hostname'] }}`)
          service: {{ app.name }}
          middlewares: [{{ app.name }}-local-only]
          tls:
            certResolver: cloudflare
      # LAN clients keep their source address; VPN peers arrive masqueraded from the AmneziaWG pod.
      middlewares:
        {{ app.name }}-local-only:
          ipAllowList:
            sourceRange:
{% for network in private_cloud.networking.local_network_cidrs %}
              - {{ network }}
{% endfor %}
              - {{ private_cloud.networking.pod_cidr }}
      services:
        {{ app.name }}:
          loadBalancer:
            servers:
              - url: http://{{ app.name }}.media.svc.cluster.local:{{ app.port }}
---
{% endfor %}
