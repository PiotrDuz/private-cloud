apiVersion: v1
kind: ServiceAccount
metadata:
  name: zabbix-agent
  namespace: private-cloud
automountServiceAccountToken: false
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: private-cloud-zabbix-agent
rules:
  - apiGroups: [""]
    resources: [pods]
    verbs: [list]
  - apiGroups: [metrics.k8s.io]
    resources: [pods]
    verbs: [list]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: private-cloud-zabbix-agent
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: private-cloud-zabbix-agent
subjects:
  - kind: ServiceAccount
    name: zabbix-agent
    namespace: private-cloud
