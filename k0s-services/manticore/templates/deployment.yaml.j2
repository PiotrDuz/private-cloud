apiVersion: apps/v1
kind: Deployment
metadata:
  name: manticore
  namespace: private-cloud
  labels:
    app.kubernetes.io/name: manticore
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: manticore
  template:
    metadata:
      labels:
        app.kubernetes.io/name: manticore
    spec:
      serviceAccountName: manticore
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 999
        runAsGroup: 999
        fsGroup: 999
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: manticore
          image: manticoresearch/manticore:29.0.2
          imagePullPolicy: IfNotPresent
          securityContext:
            runAsNonRoot: true
            privileged: false
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
          ports:
            - {name: http, containerPort: 9308, protocol: TCP}
          resources:
            requests: {cpu: 250m, memory: {{ private_cloud.manticore.max_ram | to_json }}, ephemeral-storage: 256Mi}
            limits: {memory: {{ private_cloud.manticore.max_ram | to_json }}, ephemeral-storage: 2Gi}
          startupProbe:
            tcpSocket: {port: http}
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 30
          readinessProbe:
            tcpSocket: {port: http}
            initialDelaySeconds: 5
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 24
          livenessProbe:
            tcpSocket: {port: http}
            initialDelaySeconds: 30
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 6
          volumeMounts:
            - {name: data, mountPath: /var/lib/manticore}
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: manticore-data
