{% if private_cloud.stages.grist | bool %}
{% set forward_auth_config %}
server:
  bindAddress: 0.0.0.0:4180
upstreamConfig:
  upstreams:
    - id: authenticated
      path: /
      static: true
      staticCode: 202
injectResponseHeaders:
  - name: X-Forwarded-User
    values:
      - claimSource:
          claim: email
providers:
  - id: opencloud
    provider: oidc
    name: OpenCloud
    clientID: grist-forward-auth
    clientSecretFile: /run/secrets/forward-auth/oidc-client-secret
    scope: openid profile email
    code_challenge_method: S256
    oidcConfig:
      issuerURL: {{ ("https://" ~ private_cloud.opencloud.hostname) | to_json }}
      emailClaim: email
      userIDClaim: email
      audienceClaims: [aud]
      insecureSkipNonce: false
{% endset %}
apiVersion: v1
kind: ServiceAccount
metadata:
  name: forward-auth
  namespace: edge
automountServiceAccountToken: false
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: forward-auth
  namespace: edge
data:
  oauth2-proxy.yaml: |
{{ forward_auth_config | indent(4, true) }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: forward-auth
  namespace: edge
  labels:
    app.kubernetes.io/name: forward-auth
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: forward-auth
  template:
    metadata:
      labels:
        app.kubernetes.io/name: forward-auth
      annotations:
        private-cloud.example/config-checksum: "{{ forward_auth_config | hash('sha256') }}"
        private-cloud.example/secret-revision: "{{ networking_forward_auth_secret_revision }}"
    spec:
      serviceAccountName: forward-auth
      automountServiceAccountToken: false
      enableServiceLinks: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: forward-auth
          image: {{ networking_forward_auth_image }}
          imagePullPolicy: IfNotPresent
          securityContext:
            runAsNonRoot: true
            privileged: false
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          args:
            - --alpha-config=/etc/oauth2-proxy/oauth2-proxy.yaml
            - --reverse-proxy=true
            - --trusted-proxy-ip={{ private_cloud.networking.pod_cidr }}
            - --redirect-url={{ "https://" ~ private_cloud.grist.hostname ~ "/oauth2/callback" }}
            - --whitelist-domain={{ private_cloud.grist.hostname }}
            - --whitelist-domain={{ private_cloud.opencloud.hostname }}
            - --email-domain=*
            - --skip-provider-button=true
            - --cookie-name=__Host-grist-auth
            - --cookie-secure=true
            - --cookie-httponly=true
            - --cookie-samesite=lax
            - --cookie-expire=8h
            - --silence-ping-logging=true
          env:
            - {name: GOMEMLIMIT, value: 48MiB}
            - name: OAUTH2_PROXY_COOKIE_SECRET
              valueFrom: {secretKeyRef: {name: forward-auth, key: cookie-secret}}
          ports:
            - {name: http, containerPort: 4180, protocol: TCP}
          resources:
            requests: {cpu: 25m, memory: {{ private_cloud_memory_requests.forward_auth }}, ephemeral-storage: 32Mi}
            limits: {memory: 64Mi, ephemeral-storage: 128Mi}
          readinessProbe: {httpGet: {path: /ping, port: http}, periodSeconds: 10, timeoutSeconds: 3, failureThreshold: 6}
          livenessProbe: {httpGet: {path: /ping, port: http}, initialDelaySeconds: 20, periodSeconds: 30, timeoutSeconds: 3, failureThreshold: 5}
          volumeMounts:
            - {name: config, mountPath: /etc/oauth2-proxy, readOnly: true}
            - {name: credentials, mountPath: /run/secrets/forward-auth, readOnly: true}
      volumes:
        - name: config
          configMap: {name: forward-auth}
        - name: credentials
          secret:
            secretName: forward-auth
            defaultMode: 0440
            items:
              - {key: oidc-client-secret, path: oidc-client-secret}
---
apiVersion: v1
kind: Service
metadata:
  name: forward-auth
  namespace: edge
  labels:
    app.kubernetes.io/name: forward-auth
spec:
  selector:
    app.kubernetes.io/name: forward-auth
  ports:
    - {name: http, port: 4180, targetPort: http, protocol: TCP}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: forward-auth
  namespace: edge
spec:
  podSelector:
    matchLabels: {app.kubernetes.io/name: forward-auth}
  policyTypes: [Ingress, Egress]
  ingress:
    - from:
        - podSelector:
            matchLabels: {app.kubernetes.io/name: traefik}
      ports:
        - {protocol: TCP, port: 4180}
  egress:
    - to:
        - namespaceSelector:
            matchLabels: {kubernetes.io/metadata.name: kube-system}
          podSelector:
            matchLabels: {k8s-app: kube-dns}
      ports:
        - {protocol: UDP, port: 53}
        - {protocol: TCP, port: 53}
    # HostPort traffic to the public hostname is DNATed to Traefik's pod port before policy evaluation.
    - to:
        - podSelector:
            matchLabels: {app.kubernetes.io/name: traefik}
      ports: [{protocol: TCP, port: 8443}]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: forward-auth-traefik-egress
  namespace: edge
spec:
  podSelector:
    matchLabels: {app.kubernetes.io/name: traefik}
  policyTypes: [Egress]
  egress:
    - to:
        - podSelector:
            matchLabels: {app.kubernetes.io/name: forward-auth}
      ports:
        - {protocol: TCP, port: 4180}
{% endif %}
