apiVersion: v1
kind: ConfigMap
metadata:
  name: traefik-route-amneziawg
  namespace: edge
  labels: {private-cloud.example/traefik-route: "true"}
data:
  amneziawg.yaml: |
    http:
      routers:
        amneziawg:
          entryPoints: [vpn]
          rule: Host(`{{ private_cloud.networking.amneziawg.ui_hostname }}`)
          service: amneziawg
          tls:
            certResolver: cloudflare
        amneziawg-lan:
          entryPoints: [websecure]
          rule: Host(`{{ private_cloud.networking.amneziawg.ui_hostname }}`)
          service: amneziawg
          middlewares: [local-only]
          tls:
            certResolver: cloudflare
      services:
        amneziawg:
          loadBalancer:
            servers:
              - url: http://amneziawg.network-access.svc.cluster.local:51821
