apiVersion: v1
kind: PersistentVolume
metadata:
  name: amneziawg-data
spec:
  capacity: {storage: 10Ti}
  volumeMode: Filesystem
  accessModes: [ReadWriteOnce]
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ''
  claimRef:
    namespace: network-access
    name: amneziawg-data
  local:
    path: {{ networking_amneziawg_mountpoint | to_json }}
  nodeAffinity:
    required:
      nodeSelectorTerms:
        - matchExpressions:
            - key: kubernetes.io/hostname
              operator: In
              values: [{{ networking_node_name | to_json }}]
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: amneziawg-data
  namespace: network-access
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests: {storage: 10Ti}
  storageClassName: ''
  volumeName: amneziawg-data
