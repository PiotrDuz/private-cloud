{% set homepage_stages = private_cloud.stages | dict2items | selectattr('value') | map(attribute='key') | list %}
{% set homepage_html %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ private_cloud.stalwart.domain }}</title>
<style>
:root { --bg: #f6f8fa; --text: #1f2328; --muted: #59636e; }
@media (prefers-color-scheme: dark) { :root { --bg: #0d1117; --text: #f0f6fc; --muted: #9198a1; } }
* { box-sizing: border-box; }
body { margin: 0; min-height: 100vh; background: var(--bg); color: var(--text); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
main { max-width: 720px; margin: 0 auto; padding: 48px 16px; }
h1 { margin: 0 0 32px; font-size: 28px; font-weight: 600; }
h2 { margin: 0 0 12px; color: var(--muted); font-size: 13px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
section + section { margin-top: 40px; }
ul { display: flex; flex-wrap: wrap; gap: 20px 16px; margin: 0; padding: 0; list-style: none; }
a { display: flex; flex-direction: column; align-items: center; gap: 8px; width: 88px; color: var(--text); font-size: 13px; text-align: center; text-decoration: none; }
.tile { display: grid; place-items: center; width: 72px; height: 72px; border-radius: 18px; color: #fff; transition: transform .15s, box-shadow .15s; }
a:hover .tile, a:focus-visible .tile { transform: translateY(-3px); box-shadow: 0 8px 20px rgb(0 0 0 / .18); }
a:focus-visible { outline: none; }
a:focus-visible .tile { box-shadow: 0 0 0 3px var(--bg), 0 0 0 5px var(--text); }
svg { width: 34px; height: 34px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
</style>
</head>
<body>
<main>
<h1>{{ private_cloud.stalwart.domain }}</h1>
{% for section in homepage_sections %}
{% set apps = section.apps | selectattr('stage', 'in', homepage_stages) | list %}
{% if apps %}
<section>
<h2>{{ section.name }}</h2>
<ul>
{% for app in apps %}
<li><a href="{{ app.url }}"><span class="tile" style="background: {{ app.color }}"><svg viewBox="0 0 24 24" aria-hidden="true">{{ homepage_icons[app.icon] }}</svg></span>{{ app.name }}</a></li>
{% endfor %}
</ul>
</section>
{% endif %}
{% endfor %}
</main>
</body>
</html>
{% endset %}
{% set homepage_nginx %}
server {
    listen 8080;
    server_tokens off;
    root /usr/share/nginx/html;
    add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    location = /healthz { access_log off; return 204; }
    location / { try_files /index.html =404; }
}
{% endset %}
apiVersion: v1
kind: ServiceAccount
metadata:
  name: homepage
  namespace: edge
automountServiceAccountToken: false
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: homepage
  namespace: edge
data:
  default.conf: |
{{ homepage_nginx | indent(4, true) }}
  index.html: |
{{ homepage_html | indent(4, true) }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: homepage
  namespace: edge
  labels:
    app.kubernetes.io/name: homepage
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: homepage
  template:
    metadata:
      labels:
        app.kubernetes.io/name: homepage
      annotations:
        private-cloud.example/config-checksum: "{{ (homepage_nginx ~ homepage_html) | hash('sha256') }}"
    spec:
      serviceAccountName: homepage
      automountServiceAccountToken: false
      enableServiceLinks: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 101
        runAsGroup: 101
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: homepage
          image: {{ networking_homepage_image }}
          imagePullPolicy: IfNotPresent
          command: [nginx, -g, daemon off;]
          securityContext:
            runAsNonRoot: true
            privileged: false
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          ports:
            - {name: http, containerPort: 8080, protocol: TCP}
          resources:
            requests: {cpu: 10m, memory: {{ private_cloud_memory_requests.homepage }}, ephemeral-storage: 16Mi}
            limits: {memory: 64Mi, ephemeral-storage: 64Mi}
          readinessProbe: {httpGet: {path: /healthz, port: http}, periodSeconds: 10, timeoutSeconds: 3}
          livenessProbe: {httpGet: {path: /healthz, port: http}, periodSeconds: 30, timeoutSeconds: 3}
          volumeMounts:
            - {name: config, mountPath: /etc/nginx/conf.d, readOnly: true}
            - {name: html, mountPath: /usr/share/nginx/html, readOnly: true}
            - {name: tmp, mountPath: /tmp}
      volumes:
        - name: config
          configMap: {name: homepage, items: [{key: default.conf, path: default.conf}]}
        - name: html
          configMap: {name: homepage, items: [{key: index.html, path: index.html}]}
        - {name: tmp, emptyDir: {sizeLimit: 16Mi}}
---
apiVersion: v1
kind: Service
metadata:
  name: homepage
  namespace: edge
  labels:
    app.kubernetes.io/name: homepage
spec:
  selector:
    app.kubernetes.io/name: homepage
  ports:
    - {name: http, port: 8080, targetPort: http, protocol: TCP}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: homepage
  namespace: edge
spec:
  podSelector:
    matchLabels: {app.kubernetes.io/name: homepage}
  policyTypes: [Ingress, Egress]
  ingress:
    - from:
        - podSelector:
            matchLabels: {app.kubernetes.io/name: traefik}
      ports:
        - {protocol: TCP, port: 8080}
  egress: []
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: homepage-traefik-egress
  namespace: edge
spec:
  podSelector:
    matchLabels: {app.kubernetes.io/name: traefik}
  policyTypes: [Egress]
  egress:
    - to:
        - podSelector:
            matchLabels: {app.kubernetes.io/name: homepage}
      ports:
        - {protocol: TCP, port: 8080}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: traefik-route-homepage
  namespace: edge
  labels: {private-cloud.example/traefik-route: "true"}
data:
  homepage.yaml: |
    http:
      routers:
        homepage:
          entryPoints: [websecure]
          rule: Host(`{{ private_cloud.networking.homepage_hostname }}`)
          service: homepage
          tls:
            certResolver: cloudflare
      services:
        homepage:
          loadBalancer:
            servers:
              - url: http://homepage.edge.svc.cluster.local:8080
