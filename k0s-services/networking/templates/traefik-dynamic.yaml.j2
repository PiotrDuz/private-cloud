apiVersion: v1
kind: ConfigMap
metadata:
  name: traefik-dynamic
  namespace: edge
data:
  tcp.yaml: |
    http:
      middlewares:
        strip-identity-headers:
          headers:
            customRequestHeaders:
              X-Forwarded-User: ""
              X-Forwarded-Email: ""
              X-Forwarded-Preferred-Username: ""
              X-Forwarded-Groups: ""
              X-Auth-Request-User: ""
              X-Auth-Request-Email: ""
              X-Auth-Request-Preferred-Username: ""
              X-Auth-Request-Groups: ""
              Remote-User: ""
              Remote-Email: ""
              Remote-Groups: ""
        # Traefik replaces untrusted X-Forwarded-* but passes RFC 7239 Forwarded, which Stalwart prefers.
        strip-forwarded:
          headers:
            customRequestHeaders:
              Forwarded: ""
        # oauth2-proxy answers 202 with the verified email in X-Forwarded-User, or redirects the browser to OpenCloud sign-in.
        forward-auth:
          forwardAuth:
            address: http://forward-auth.edge.svc.cluster.local:4180/
            trustForwardHeader: false
            authResponseHeaders:
              - X-Forwarded-User
