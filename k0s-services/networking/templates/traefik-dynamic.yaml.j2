apiVersion: v1
kind: ConfigMap
metadata:
  name: traefik-dynamic
  namespace: edge
data:
  tcp.yaml: |
    http:
      middlewares:
        # Both entrypoints attach this to every router; no frame, CSP, or permissions policy because OpenCloud embeds editors.
        security-headers:
          headers:
            stsSeconds: 31536000
            stsIncludeSubdomains: false
            stsPreload: false
            contentTypeNosniff: true
            referrerPolicy: strict-origin-when-cross-origin
        strip-identity-headers:
          headers:
            customRequestHeaders:
              X-Forwarded-User: ""
              X-Forwarded-Email: ""
              X-Forwarded-Preferred-Username: ""
              X-Forwarded-Groups: ""
              X-Auth-Request-User: ""
              X-Auth-Request-Email: ""
              X-Auth-Request-Preferred-Username: ""
              X-Auth-Request-Groups: ""
              Remote-User: ""
              Remote-Email: ""
              Remote-Groups: ""
        # Traefik replaces untrusted X-Forwarded-* but passes RFC 7239 Forwarded, which Stalwart prefers.
        strip-forwarded:
          headers:
            customRequestHeaders:
              Forwarded: ""
        # Local-only routers on websecure admit LAN clients; VPN peers use the vpn entrypoint, which only the AmneziaWG pod reaches.
        local-only:
          ipAllowList:
            sourceRange:
{% for network in private_cloud.networking.local_network_cidrs %}
              - {{ network }}
{% endfor %}
        # oauth2-proxy answers 202 with the verified email in X-Forwarded-User, or redirects the browser to Stalwart sign-in.
        forward-auth:
          forwardAuth:
            address: http://forward-auth.edge.svc.cluster.local:4180/
            trustForwardHeader: false
            authResponseHeaders:
              - X-Forwarded-User
