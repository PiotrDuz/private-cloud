apiVersion: apps/v1
kind: Deployment
metadata:
  name: immich-machine-learning
  namespace: private-cloud
  labels:
    app.kubernetes.io/name: immich-machine-learning
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: immich-machine-learning
  template:
    metadata:
      labels:
        app.kubernetes.io/name: immich-machine-learning
    spec:
      serviceAccountName: immich-machine-learning
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        fsGroupChangePolicy: OnRootMismatch
{% if private_cloud.immich.machine_learning_accelerator == 'openvino' %}
        supplementalGroups:
          - {{ intel_gpu_render_group_id }}
{% endif %}
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: immich-machine-learning
{% if private_cloud.immich.machine_learning_accelerator == 'openvino' %}
          image: ghcr.io/immich-app/immich-machine-learning:v3.1.0-openvino@sha256:4b6ef958e7749fc548377bb23ee219c09c74da8decee080d76dc6a388c39b013
{% else %}
          image: ghcr.io/immich-app/immich-machine-learning:v3.1.0@sha256:5a0839dc5303cd7215bcd2180a26aed3af41675aefb3e75e5157e9f10ad16e6e
{% endif %}
          imagePullPolicy: IfNotPresent
          securityContext:
            runAsNonRoot: true
            privileged: false
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
          env:
            - {name: TZ, value: {{ private_cloud.immich.timezone | to_json }}}
            - {name: IMMICH_ENV, value: production}
            - {name: MACHINE_LEARNING_CACHE_FOLDER, value: /cache}
          ports:
            - {name: http, containerPort: 3003, protocol: TCP}
          resources:
            requests:
              cpu: 250m
              memory: {{ private_cloud.immich.machine_learning_max_ram | to_json }}
              ephemeral-storage: 2Gi
{% if private_cloud.immich.machine_learning_accelerator == 'openvino' %}
              gpu.intel.com/i915: 1
{% endif %}
            limits:
              memory: {{ private_cloud.immich.machine_learning_max_ram | to_json }}
              ephemeral-storage: 10Gi
{% if private_cloud.immich.machine_learning_accelerator == 'openvino' %}
              gpu.intel.com/i915: 1
{% endif %}
          startupProbe:
            httpGet: {path: /ping, port: http}
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 30
          readinessProbe:
            httpGet: {path: /ping, port: http}
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 30
          livenessProbe:
            httpGet: {path: /ping, port: http}
            initialDelaySeconds: 60
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 5
          volumeMounts:
            - {name: model-cache, mountPath: /cache}
      volumes:
        - name: model-cache
          emptyDir:
            sizeLimit: 10Gi
