apiVersion: apps/v1
kind: Deployment
metadata:
  name: immich-valkey
  namespace: private-cloud
  labels:
    app.kubernetes.io/name: immich-valkey
spec:
  replicas: 1
  strategy: {type: Recreate}
  selector:
    matchLabels:
      app.kubernetes.io/name: immich-valkey
  template:
    metadata:
      labels:
        app.kubernetes.io/name: immich-valkey
    spec:
      serviceAccountName: immich-valkey
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 999
        runAsGroup: 1000
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: valkey
          image: docker.io/valkey/valkey:9@sha256:8e8d64b405ce18f41b8e5ee20aa4687a8ed0022d1298f2ce31cdcf3a76e09411
          imagePullPolicy: IfNotPresent
          securityContext:
            runAsNonRoot: true
            privileged: false
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
          args: [valkey-server, --save, "", --appendonly, "no"]
          ports:
            - {name: valkey, containerPort: 6379, protocol: TCP}
          resources:
            requests: {cpu: 100m, memory: {{ private_cloud.immich.valkey_max_ram | to_json }}, ephemeral-storage: 128Mi}
            limits: {memory: {{ private_cloud.immich.valkey_max_ram | to_json }}, ephemeral-storage: 1Gi}
          startupProbe:
            exec: {command: [valkey-cli, ping]}
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 30
          readinessProbe:
            exec: {command: [valkey-cli, ping]}
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 30
          livenessProbe:
            exec: {command: [valkey-cli, ping]}
            initialDelaySeconds: 30
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 5
