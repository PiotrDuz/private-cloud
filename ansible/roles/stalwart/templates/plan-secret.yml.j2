apiVersion: v1
kind: Secret
metadata:
  name: {{ stalwart_plan_secret_name }}
  namespace: {{ stalwart_namespace }}
  annotations:
    private-cloud.example/managed-by: ansible
type: Opaque
stringData:
  plan.ndjson: |
    {"@type":"update","object":"BlobStore","value":{"@type":"FileSystem","path":"/var/lib/stalwart/blobs","depth":2}}
    {"@type":"update","object":"SearchStore","value":{"@type":"Meilisearch","url":"http://{{ stalwart_meilisearch_service }}:7700","httpAuth":{"@type":"Bearer","bearerToken":{"@type":"EnvironmentVariable","variableName":"MEILI_MASTER_KEY"}}}}
    {"@type":"update","object":"InMemoryStore","value":{"@type":"Default"}}
    {"@type":"upsert","object":"AcmeProvider","matchOn":["directory"],"value":{"acme":{"directory":"https://acme-v02.api.letsencrypt.org/directory","challengeType":"TlsAlpn01","contact":{"0":{{ private_cloud.stalwart.acme_contact | to_json }}},"renewBefore":"R23","maxRetries":10}}}
    {"@type":"upsert","object":"Domain","matchOn":["name"],"value":{"primary-domain":{"name":{{ private_cloud.stalwart.domain | to_json }},"isEnabled":true,"allowRelaying":false,"subAddressing":{"@type":"Enabled"},"dkimManagement":{"@type":"Manual"},"dnsManagement":{"@type":"Manual"},"certificateManagement":{"@type":"Manual"}},"forwarding-domain":{"name":{{ private_cloud.stalwart.forwarding_domain | to_json }},"isEnabled":true,"allowRelaying":false,"subAddressing":{"@type":"Disabled"},"dkimManagement":{"@type":"Manual"},"dnsManagement":{"@type":"Manual"},"certificateManagement":{"@type":"Manual"}},"tls-domain":{"name":{{ private_cloud.stalwart.hostname | to_json }},"isEnabled":true,"allowRelaying":false,"subAddressing":{"@type":"Disabled"},"dkimManagement":{"@type":"Manual"},"dnsManagement":{"@type":"Manual"},"certificateManagement":{"@type":"Automatic","acmeProviderId":"#acme","subjectAlternativeNames":{"0":{{ private_cloud.stalwart.hostname | to_json }}}}}}}
    {"@type":"upsert","object":"Account","matchOn":["name","domainId"],"value":{"admin-account":{"@type":"User","name":{{ private_cloud.stalwart.admin_username | to_json }},"domainId":"#primary-domain","credentials":{"0":{"@type":"Password","secret":{{ private_cloud_secrets.stalwart.admin_password | to_json }}}},"roles":{"@type":"Admin"},"permissions":{"@type":"Inherit"},"encryptionAtRest":{"@type":"Disabled"}},"mailbox-account":{"@type":"User","name":{{ private_cloud.stalwart.mailbox_username | to_json }},"domainId":"#primary-domain","aliases":{"0":{"name":{{ private_cloud.stalwart.mailbox_username | to_json }},"domainId":"#forwarding-domain","enabled":true}},"credentials":{"0":{"@type":"Password","secret":{{ private_cloud_secrets.stalwart.mailbox_password | to_json }}}},"roles":{"@type":"User"},"permissions":{"@type":"Inherit"},"encryptionAtRest":{"@type":"Disabled"}}}}
    {"@type":"update","object":"SystemSettings","value":{"defaultDomainId":"#primary-domain","defaultHostname":{{ private_cloud.stalwart.hostname | to_json }}}}
    {"@type":"upsert","object":"NetworkListener","matchOn":["name"],"value":{"management":{"name":"management","protocol":"http","bind":{"0":"[::]:8080"},"useTls":false},"https":{"name":"https","protocol":"http","bind":{"0":"[::]:443"},"useTls":true,"tlsImplicit":true},"smtp":{"name":"smtp","protocol":"smtp","bind":{"0":"[::]:25"},"useTls":true,"tlsImplicit":false},"submissions":{"name":"submissions","protocol":"smtp","bind":{"0":"[::]:465"},"useTls":true,"tlsImplicit":true},"submission":{"name":"submission","protocol":"smtp","bind":{"0":"[::]:587"},"useTls":true,"tlsImplicit":false},"imaps":{"name":"imaps","protocol":"imap","bind":{"0":"[::]:993"},"useTls":true,"tlsImplicit":true}}}
    {"@type":"upsert","object":"MtaRoute","matchOn":["name"],"value":{"inbox-eu":{"@type":"Relay","name":"inbox-eu","address":{{ private_cloud.stalwart.relay_host | to_json }},"port":{{ private_cloud.stalwart.relay_port }},"protocol":"smtp","implicitTls":{{ private_cloud.stalwart.relay_implicit_tls | to_json }},"allowInvalidCerts":false,"authUsername":{{ private_cloud.stalwart.relay_username | to_json }},"authSecret":{"@type":"EnvironmentVariable","variableName":"INBOX_EU_SMTP_PASSWORD"}}}}
    {"@type":"update","object":"MtaOutboundStrategy","value":{"route":{"match":{"0":{"if":"is_local_domain(rcpt_domain)","then":"'local'"}},"else":"'inbox-eu'"}}}
