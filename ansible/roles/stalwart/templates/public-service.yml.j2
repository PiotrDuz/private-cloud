apiVersion: v1
kind: Service
metadata:
  name: {{ stalwart_public_service_name }}
  namespace: {{ stalwart_namespace }}
  labels:
    app.kubernetes.io/name: stalwart
spec:
  type: NodePort
  selector:
    app.kubernetes.io/name: stalwart
  ports:
    - name: https
      port: 443
      targetPort: https
      nodePort: {{ private_cloud.stalwart.https_node_port }}
      protocol: TCP
    - name: smtp
      port: 25
      targetPort: smtp
      nodePort: {{ private_cloud.stalwart.smtp_node_port }}
      protocol: TCP
    - name: submissions
      port: 465
      targetPort: submissions
      nodePort: {{ private_cloud.stalwart.submissions_node_port }}
      protocol: TCP
    - name: submission
      port: 587
      targetPort: submission
      nodePort: {{ private_cloud.stalwart.submission_node_port }}
      protocol: TCP
    - name: imaps
      port: 993
      targetPort: imaps
      nodePort: {{ private_cloud.stalwart.imaps_node_port }}
      protocol: TCP
