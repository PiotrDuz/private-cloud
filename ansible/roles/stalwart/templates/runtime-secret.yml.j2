apiVersion: v1
kind: Secret
metadata:
  name: {{ stalwart_runtime_secret_name }}
  namespace: {{ stalwart_namespace }}
  annotations:
    private-cloud.example/managed-by: ansible
type: Opaque
stringData:
  STALWART_DB_PASSWORD: {{ private_cloud_secrets.stalwart.database_password | to_json }}
  INBOX_EU_SMTP_PASSWORD: {{ private_cloud_secrets.stalwart.relay_password | to_json }}
