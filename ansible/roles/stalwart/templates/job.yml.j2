apiVersion: batch/v1
kind: Job
metadata:
  name: {{ stalwart_plan_job_name }}
  namespace: {{ stalwart_namespace }}
  labels:
    app.kubernetes.io/name: stalwart
    app.kubernetes.io/component: configuration
spec:
  backoffLimit: 2
  ttlSecondsAfterFinished: 300
  template:
    metadata:
      labels:
        app.kubernetes.io/name: stalwart
        app.kubernetes.io/component: configuration
    spec:
      restartPolicy: Never
      containers:
        - name: configure
          image: {{ stalwart_cli_image }}
          imagePullPolicy: IfNotPresent
          args:
            - apply
            - --file
            - /configuration/plan.ndjson
            - --json
          env:
            - name: STALWART_URL
              value: http://stalwart:8080
            - name: STALWART_USER
              valueFrom:
                secretKeyRef:
                  name: {{ stalwart_recovery_secret_name }}
                  key: STALWART_USER
            - name: STALWART_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ stalwart_recovery_secret_name }}
                  key: STALWART_PASSWORD
          volumeMounts:
            - name: configuration
              mountPath: /configuration
              readOnly: true
      volumes:
        - name: configuration
          secret:
            secretName: {{ stalwart_plan_secret_name }}
