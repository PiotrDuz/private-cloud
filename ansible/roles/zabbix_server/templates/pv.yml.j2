apiVersion: v1
kind: PersistentVolume
metadata:
  name: {{ zabbix_pv_name }}
  labels:
    app.kubernetes.io/name: zabbix
    app.kubernetes.io/component: server-data
spec:
  capacity:
    storage: {{ zabbix_pv_capacity }}
  volumeMode: Filesystem
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ""
  claimRef:
    namespace: {{ zabbix_namespace }}
    name: {{ zabbix_pvc_name }}
  local:
    path: {{ zabbix_dataset_mountpoint }}
  nodeAffinity:
    required:
      nodeSelectorTerms:
        - matchExpressions:
            - key: kubernetes.io/hostname
              operator: In
              values:
                - {{ zabbix_node_name | quote }}
