apiVersion: v1
kind: Service
metadata:
  name: zabbix-web
  namespace: {{ zabbix_namespace }}
  labels: {app.kubernetes.io/name: zabbix, app.kubernetes.io/component: web}
spec:
  type: NodePort
  selector: {app.kubernetes.io/name: zabbix, app.kubernetes.io/component: web}
  ports: [{name: http, port: 80, targetPort: http, nodePort: {{ private_cloud.zabbix.web_node_port }}, protocol: TCP}]
