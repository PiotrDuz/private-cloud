apiVersion: v1
kind: Service
metadata:
  name: {{ onlyoffice_public_service_name }}
  namespace: {{ onlyoffice_namespace }}
  labels:
    app.kubernetes.io/name: onlyoffice
spec:
  type: NodePort
  selector:
    app.kubernetes.io/name: onlyoffice
  ports:
    - name: http
      port: 80
      targetPort: http
      nodePort: {{ private_cloud.onlyoffice.node_port }}
      protocol: TCP
