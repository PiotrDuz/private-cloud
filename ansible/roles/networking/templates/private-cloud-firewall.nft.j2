destroy table inet private_cloud

table inet private_cloud {
    set local_networks {
        type ipv4_addr
        flags interval
        elements = { {{ private_cloud.networking.local_network_cidrs | join(', ') }} }
    }

    chain prerouting {
        type filter hook prerouting priority mangle; policy accept;

        iifname {{ ansible_default_ipv4.interface | to_json }} ct state established,related accept
        iifname {{ ansible_default_ipv4.interface | to_json }} fib daddr type local ip saddr @local_networks tcp dport { 22, 6443, 31051 } ct mark set 0x5043 accept
        iifname {{ ansible_default_ipv4.interface | to_json }} fib daddr type local tcp dport { 25, 443 } ct mark set 0x5043 accept
        iifname {{ ansible_default_ipv4.interface | to_json }} fib daddr type local udp dport {{ private_cloud.networking.amneziawg.listen_port }} ct mark set 0x5043 accept
        iifname {{ ansible_default_ipv4.interface | to_json }} fib daddr type local udp sport 67 udp dport 68 accept
        iifname {{ ansible_default_ipv4.interface | to_json }} fib daddr type local meta l4proto { icmp, ipv6-icmp } accept
        iifname {{ ansible_default_ipv4.interface | to_json }} fib daddr type local drop
    }

    chain input {
        type filter hook input priority filter; policy drop;

        ct state invalid drop
        ct state established,related accept
        iifname "lo" accept
        ip saddr {{ private_cloud.networking.pod_cidr }} accept
        ip saddr @local_networks tcp dport { 22, 6443, 31051 } accept
        tcp dport { 25, 443 } accept
        udp dport {{ private_cloud.networking.amneziawg.listen_port }} accept
        udp sport 67 udp dport 68 accept
        ip protocol icmp accept
        meta l4proto ipv6-icmp accept
    }

    chain forward {
        type filter hook forward priority filter; policy accept;

        ct state invalid drop
        ct state established,related accept
        ct mark 0x5043 accept
        iifname {{ ansible_default_ipv4.interface | to_json }} ip daddr { {{ private_cloud.networking.pod_cidr }}, {{ private_cloud.networking.service_cidr }} } drop
    }
}
