{# Every namespace runs a pod that baseline rejects, so baseline is audited rather than enforced; warn would flood every apply. #}
{% for namespace in [k0s_namespace, 'media', 'edge', 'network-access', 'dns-system', 'observability'] %}
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ namespace }}
  labels:
    kubernetes.io/metadata.name: {{ namespace }}
    pod-security.kubernetes.io/enforce: privileged
    pod-security.kubernetes.io/enforce-version: {{ k0s_pod_security_version }}
    pod-security.kubernetes.io/audit: baseline
    pod-security.kubernetes.io/audit-version: {{ k0s_pod_security_version }}
{% endfor %}
