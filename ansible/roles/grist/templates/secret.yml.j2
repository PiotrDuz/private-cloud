apiVersion: v1
kind: Secret
metadata:
  name: {{ grist_secret_name }}
  namespace: {{ grist_namespace }}
  annotations:
    private-cloud.example/managed-by: ansible
type: Opaque
stringData:
  GRIST_DB_PASSWORD: {{ private_cloud_secrets.grist.database_password | to_json }}
  GRIST_SESSION_SECRET: {{ private_cloud_secrets.grist.session_secret | to_json }}
  GRIST_BOOT_KEY: {{ private_cloud_secrets.grist.boot_key | to_json }}
