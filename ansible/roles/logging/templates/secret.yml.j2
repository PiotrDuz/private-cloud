apiVersion: v1
kind: Secret
metadata:
  name: grafana-credentials
  namespace: observability
  annotations: {private-cloud.example/managed-by: ansible}
type: Opaque
stringData:
  GF_SECURITY_ADMIN_PASSWORD: {{ private_cloud_secrets.logging.admin_password | to_json }}
  GF_SECURITY_SECRET_KEY: {{ private_cloud_secrets.logging.secret_key | to_json }}
{% if private_cloud.stages.notifications %}
  GF_SMTP_PASSWORD: {{ private_cloud_secrets.stalwart.relay_password | to_json }}
{% endif %}
