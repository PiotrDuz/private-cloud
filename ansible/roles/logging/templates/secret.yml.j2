apiVersion: v1
kind: Secret
metadata:
  name: openobserve-admin
  namespace: observability
  annotations: {private-cloud.example/managed-by: ansible}
type: Opaque
stringData:
  username: {{ (private_cloud.stalwart.mailbox_username ~ '@' ~ private_cloud.stalwart.domain) | to_json }}
  admin-password: {{ private_cloud_secrets.logging.admin_password | to_json }}
