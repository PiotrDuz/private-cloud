apiVersion: v1
kind: Secret
metadata:
  name: openobserve-ingest
  namespace: observability
  annotations: {private-cloud.example/managed-by: ansible}
type: Opaque
stringData:
  username: {{ (private_cloud.stalwart.mailbox_username ~ '@' ~ private_cloud.stalwart.forwarding_domain) | to_json }}
  admin-password: {{ private_cloud_secrets.logging.admin_password | to_json }}
{% if private_cloud.stages.notifications %}
  smtp-password: {{ private_cloud_secrets.stalwart.relay_password | to_json }}
{% endif %}
