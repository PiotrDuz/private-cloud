apiVersion: batch/v1
kind: Job
metadata:
  name: {{ affine_migration_job_name }}
  namespace: {{ affine_namespace }}
  labels:
    app.kubernetes.io/name: affine-migration
spec:
  backoffLimit: 3
  template:
    metadata:
      labels: {app.kubernetes.io/name: affine-migration}
    spec:
      restartPolicy: OnFailure
      containers:
        - name: migration
          image: {{ affine_image }}
          imagePullPolicy: IfNotPresent
          command: [sh, -c, 'node ./scripts/self-host-predeploy.js']
          env:
            - {name: REDIS_SERVER_HOST, value: "{{ affine_redis_service_name }}"}
            - name: DATABASE_URL
              valueFrom: {secretKeyRef: {name: "{{ affine_secret_name }}", key: DATABASE_URL}}
          volumeMounts:
            - {name: data, mountPath: /root/.affine/storage, subPath: storage}
            - {name: data, mountPath: /root/.affine/config, subPath: config}
      volumes:
        - name: data
          persistentVolumeClaim: {claimName: "{{ affine_pvc_name }}"}
