apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ affine_service_name }}
  namespace: {{ affine_namespace }}
  labels:
    app.kubernetes.io/name: affine
spec:
  replicas: 1
  strategy: {type: Recreate}
  selector:
    matchLabels: {app.kubernetes.io/name: affine}
  template:
    metadata:
      labels: {app.kubernetes.io/name: affine}
    spec:
      terminationGracePeriodSeconds: 60
      containers:
        - name: affine
          image: {{ affine_image }}
          imagePullPolicy: IfNotPresent
          env:
            - {name: REDIS_SERVER_HOST, value: "{{ affine_redis_service_name }}"}
            - name: DATABASE_URL
              valueFrom: {secretKeyRef: {name: "{{ affine_secret_name }}", key: DATABASE_URL}}
          ports:
            - {name: http, containerPort: 3010, protocol: TCP}
          resources:
            requests: {memory: "{{ private_cloud.affine.max_ram }}"}
            limits: {memory: "{{ private_cloud.affine.max_ram }}"}
          readinessProbe:
            httpGet: {path: /, port: http}
            initialDelaySeconds: 30
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 30
          livenessProbe:
            httpGet: {path: /, port: http}
            initialDelaySeconds: 90
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 5
          volumeMounts:
            - {name: data, mountPath: /root/.affine/storage, subPath: storage}
            - {name: data, mountPath: /root/.affine/config, subPath: config}
      volumes:
        - name: data
          persistentVolumeClaim: {claimName: "{{ affine_pvc_name }}"}
