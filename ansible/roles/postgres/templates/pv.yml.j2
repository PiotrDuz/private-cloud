apiVersion: v1
kind: PersistentVolume
metadata:
  name: {{ postgres_pv_name }}
  labels:
    app.kubernetes.io/name: postgres
spec:
  capacity:
    storage: {{ postgres_pv_capacity }}
  volumeMode: Filesystem
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ""
  claimRef:
    namespace: {{ postgres_namespace }}
    name: {{ postgres_pvc_name }}
  local:
    path: {{ postgres_dataset_mountpoint }}
  nodeAffinity:
    required:
      nodeSelectorTerms:
        - matchExpressions:
            - key: kubernetes.io/hostname
              operator: In
              values:
                - {{ postgres_node_name | quote }}
