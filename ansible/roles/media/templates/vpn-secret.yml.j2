apiVersion: v1
kind: Secret
metadata:
  name: media-vpn
  namespace: media
  annotations:
    private-cloud.example/managed-by: ansible
type: Opaque
stringData:
  proxy-password: {{ private_cloud_secrets.media.proxy_password | to_json }}
  wireguard-private-key: {{ private_cloud_secrets.media.wireguard_private_key | to_json }}
  wireguard-preshared-key: {{ private_cloud_secrets.media.wireguard_preshared_key | to_json }}
