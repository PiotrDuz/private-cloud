apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ opencloud_service_name }}
  namespace: {{ opencloud_namespace }}
  labels:
    app.kubernetes.io/name: opencloud
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: opencloud
  template:
    metadata:
      labels:
        app.kubernetes.io/name: opencloud
      annotations:
        private-cloud.example/apps-config-checksum: {{ lookup('template', 'apps-configmap.yml.j2') | hash('sha256') }}
        private-cloud.example/app-registry-config-checksum: {{ lookup('template', 'app-registry-configmap.yml.j2') | hash('sha256') }}
        private-cloud.example/csp-config-checksum: {{ lookup('template', 'csp-configmap.yml.j2') | hash('sha256') }}
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        - name: install-drawio
          image: {{ opencloud_drawio_installer_image }}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -c
          args:
            - |
              set -eu
              app_dir=/opencloud/data/web/assets/apps/draw-io
              if ! grep -q '"version": "{{ opencloud_drawio_version }}"' "$app_dir/manifest.json" 2>/dev/null; then
                archive=/tmp/draw-io.zip
                wget -q -O "$archive" {{ opencloud_drawio_url }}
                echo "{{ opencloud_drawio_checksum }}  $archive" | sha256sum -c -
                mkdir -p /opencloud/config /opencloud/data/web/assets/apps
                unzip -oq "$archive" -d /opencloud/data/web/assets/apps
              fi
          securityContext:
            runAsNonRoot: true
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
            seccompProfile:
              type: RuntimeDefault
          volumeMounts:
            - name: data
              mountPath: /opencloud
      containers:
        - name: opencloud
          image: {{ opencloud_image }}
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
            - -c
          args:
            - opencloud init || true; opencloud server
          securityContext:
            runAsNonRoot: true
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
            seccompProfile:
              type: RuntimeDefault
          env:
            - name: OC_URL
              value: https://{{ private_cloud.opencloud.hostname }}
            - name: PROXY_HTTP_ADDR
              value: 0.0.0.0:9200
            - name: PROXY_TLS
              value: "false"
            - name: OC_INSECURE
              value: "false"
            - name: IDM_CREATE_DEMO_USERS
              value: "false"
            - name: IDM_ADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ opencloud_secret_name }}
                  key: IDM_ADMIN_PASSWORD
            - name: SEARCH_ENGINE_TYPE
              value: bleve
            - name: SEARCH_ENGINE_BLEVE_DATA_PATH
              value: /var/lib/opencloud/search
            - name: SEARCH_EXTRACTOR_TYPE
              value: tika
            - name: SEARCH_EXTRACTOR_TIKA_TIKA_URL
              value: {{ opencloud_tika_url }}
            - name: FRONTEND_FULL_TEXT_SEARCH_ENABLED
              value: "true"
            - name: OC_CACHE_STORE
              value: memory
            - name: STORAGE_USERS_DRIVER
              value: posix
            - name: STORAGE_USERS_POSIX_ROOT
              value: /var/lib/opencloud/storage/users
            - name: STORAGE_USERS_ID_CACHE_STORE
              value: nats-js-kv
            - name: STORAGE_SYSTEM_DRIVER
              value: decomposed
            - name: WEB_ASSET_APPS_PATH
              value: /var/lib/opencloud/web/assets/apps
            - name: PROXY_CSP_CONFIG_FILE_LOCATION
              value: /etc/opencloud/csp.yaml
            - name: OC_ADD_RUN_SERVICES
              value: collaboration
            - name: COLLABORATION_APP_NAME
              value: OnlyOffice
            - name: COLLABORATION_APP_PRODUCT
              value: OnlyOffice
            - name: COLLABORATION_APP_ADDR
              value: https://{{ private_cloud.onlyoffice.hostname }}
            - name: COLLABORATION_APP_ICON
              value: https://{{ private_cloud.onlyoffice.hostname }}/web-apps/apps/documenteditor/main/resources/img/favicon.ico
            - name: COLLABORATION_APP_INSECURE
              value: "false"
            - name: COLLABORATION_APP_PROOF_DISABLE
              value: "true"
            - name: COLLABORATION_WOPI_SRC
              value: https://{{ private_cloud.opencloud.hostname }}
            - name: COLLABORATION_CS3API_DATAGATEWAY_INSECURE
              value: "false"
          ports:
            - name: http
              containerPort: 9200
              protocol: TCP
          resources:
            requests:
              memory: {{ private_cloud.opencloud.max_ram }}
            limits:
              memory: {{ private_cloud.opencloud.max_ram }}
          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 10
            periodSeconds: 5
            timeoutSeconds: 3
            failureThreshold: 24
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 60
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 6
          volumeMounts:
            - name: data
              mountPath: /etc/opencloud
              subPath: config
            - name: data
              mountPath: /var/lib/opencloud
              subPath: data
            - name: bleve-data
              mountPath: /var/lib/opencloud/search
            - name: apps-config
              mountPath: /etc/opencloud/apps.yaml
              subPath: apps.yaml
              readOnly: true
            - name: app-registry-config
              mountPath: /etc/opencloud/app-registry.yaml
              subPath: app-registry.yaml
              readOnly: true
            - name: csp-config
              mountPath: /etc/opencloud/csp.yaml
              subPath: csp.yaml
              readOnly: true
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: {{ opencloud_pvc_name }}
        - name: bleve-data
          persistentVolumeClaim:
            claimName: {{ opencloud_bleve_pvc_name }}
        - name: apps-config
          configMap:
            name: {{ opencloud_apps_config_name }}
        - name: app-registry-config
          configMap:
            name: {{ opencloud_app_registry_config_name }}
        - name: csp-config
          configMap:
            name: {{ opencloud_csp_config_name }}
